# Neon serverless Postgres connection string (pooled).
# Get it from https://console.neon.tech → your project → Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/goatsbattle?sslmode=require"

# Database-changing scripts require an explicit --target flag and verify a
# persistent deployment_environment marker before writing. Keep the current
# .env development-only. Put the fresh production connection in .env.production.
# Never point both files at the same Neon database/branch.

# Secret salt mixed into the SHA-256 IP hash for GDPR-safe vote dedup.
# Generate one with:  openssl rand -hex 32
IP_HASH_SALT="change-me-to-a-long-random-string"

# ─── Auth (better-auth) ───────────────────────────────────────────────────────
# Signing secret for sessions/tokens. Generate with:  openssl rand -hex 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
# Public origin of the app (no trailing slash). http://localhost:4321 in dev.
BETTER_AUTH_URL="http://localhost:4321"
# Google OAuth credentials (Google Cloud console → Credentials → OAuth client).
# Authorized redirect URI to register: ${BETTER_AUTH_URL}/api/auth/callback/google
PUBLIC_GOOGLE_AUTH_ENABLED=false
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── API-Football (optional legacy development import tooling) ────────────────
# Used only by scripts/sync-matches.ts via db:sync:matches:dev to import a
# curated set of historical World Cup 2022 matches. It is not used by the
# Worker runtime or the current live-data pipeline. Free tier = 100
# requests/day, so the script batches its work. Get a key from
# https://www.api-football.com/ (or the RapidAPI listing).
API_FOOTBALL_KEY=""

# TheStatsAPI World Cup score, timeline, stats, and lineup provider. This is a
# server-only secret: add it to .env for Node scripts and use Wrangler secrets
# for preview/production Workers. Never expose it as PUBLIC_*.
THESTATSAPI_API_KEY=""
LIVE_MOMENTS_ENABLED="true"

# Used only by the guarded production owner-auth verifier; never bundled.
EXPECTED_OWNER_EMAIL=""

# Neon serverless Postgres connection string (pooled).
# Get it from https://console.neon.tech → your project → Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/goatsbattle?sslmode=require"

# Secret salt mixed into the SHA-256 IP hash for GDPR-safe vote dedup.
# Generate one with:  openssl rand -hex 32
IP_HASH_SALT="change-me-to-a-long-random-string"

# ─── Auth (better-auth) ───────────────────────────────────────────────────────
# Signing secret for sessions/tokens. Generate with:  openssl rand -hex 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
# Public origin of the app (no trailing slash). http://localhost:4321 in dev.
BETTER_AUTH_URL="http://localhost:4321"
# Google OAuth credentials (Google Cloud console → Credentials → OAuth client).
# Authorized redirect URI to register: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── API-Football (future live match sync — not used yet) ─────────────────────
# The Floor's match events are hand-seeded today (scripts/seed-matches.ts). The
# later live-sync phase will read this key. Free tier = 100 requests/day, so the
# sync must be batched/cached — never fetched per request. Get a key at
# https://www.api-football.com/ (or the RapidAPI listing). Read it the way
# src/lib/db/index.ts reads DATABASE_URL — process.env.API_FOOTBALL_KEY ??
# import.meta.env.API_FOOTBALL_KEY (both static accesses; no optional chaining or
# dynamic access) — since the sync runs as a node script where import.meta.env
# alone isn't populated.
API_FOOTBALL_KEY=""

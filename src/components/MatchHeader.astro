---
/**
 * The "post heading" atop a Reddit-style event page: the fixture, big scoreline,
 * competition/venue/kickoff meta, status, and the tracked goats who played.
 */
import type { FloorEvent } from '../lib/queries';
import { flagEmoji } from '../lib/format';

interface Props {
  event: FloorEvent;
}

const { event } = Astro.props;
const isLive = event.status === 'live';
const isUpcoming = event.status === 'scheduled';
const hasScore = event.homeScore !== null && event.awayScore !== null;

const kickoffLabel = event.kickoff.toLocaleDateString(undefined, {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

function textOn(hex: string): string {
  const h = hex.replace('#', '');
  if (h.length < 6) return '#0d0d0f';
  const r = parseInt(h.slice(0, 2), 16);
  const g = parseInt(h.slice(2, 4), 16);
  const b = parseInt(h.slice(4, 6), 16);
  return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.6 ? '#0d0d0f' : '#f0f0f2';
}
---

<div class="bg-canvas-soft border border-hairline rounded-lg overflow-hidden">
  {/* Top meta */}
  <div class="flex items-center justify-between gap-3 px-5 sm:px-6 py-3.5 border-b border-hairline">
    <span class="font-mono text-[10px] sm:text-[10.5px] uppercase tracking-[0.16em] text-mute">{event.competition}</span>
    {isLive ? (
      <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.12em] text-red">
        <span class="live-dot gb-pulse-fast" style="--dot: var(--color-red)"></span> Live
      </span>
    ) : (
      <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-mute border border-hairline rounded-full px-2.5 py-1">
        {isUpcoming ? 'Upcoming' : 'Full time'}
      </span>
    )}
  </div>

  {/* Scoreline — name inner, flag outer; score digits in side colours */}
  <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 sm:gap-4 px-4 sm:px-6 py-6 sm:py-7">
    <div class="flex flex-col sm:flex-row items-center sm:justify-end gap-1.5 sm:gap-4">
      <span class="font-headline font-black uppercase text-ink text-2xl sm:text-4xl md:text-5xl leading-none text-center sm:text-right">{event.homeTeam}</span>
      <span class="text-3xl sm:text-4xl leading-none order-first sm:order-none">{flagEmoji(event.homeCode ?? '')}</span>
    </div>

    <div class="flex items-center justify-center gap-2 sm:gap-4 px-1 sm:px-5">
      {hasScore ? (
        <>
          <span class="font-headline font-black text-lime text-4xl sm:text-6xl leading-none tabular-nums">{event.homeScore}</span>
          <span class="font-headline font-black text-hairline-strong text-2xl sm:text-4xl leading-none">–</span>
          <span class="font-headline font-black text-red text-4xl sm:text-6xl leading-none tabular-nums">{event.awayScore}</span>
        </>
      ) : (
        <span class="font-headline font-black italic text-mute text-xl sm:text-3xl leading-none">VS</span>
      )}
    </div>

    <div class="flex flex-col sm:flex-row items-center sm:justify-start gap-1.5 sm:gap-4">
      <span class="text-3xl sm:text-4xl leading-none">{flagEmoji(event.awayCode ?? '')}</span>
      <span class="font-headline font-black uppercase text-ink text-2xl sm:text-4xl md:text-5xl leading-none text-center sm:text-left">{event.awayTeam}</span>
    </div>
  </div>

  {/* Bottom meta */}
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 px-5 sm:px-6 py-3.5 border-t border-hairline bg-sunken font-mono text-[10.5px] uppercase tracking-[0.12em] text-mute">
    <span>{kickoffLabel}</span>
    {event.venue && (<><span class="text-hairline-strong">·</span><span>{event.venue}</span></>)}
    {event.goats.length > 0 && (
      <span class="flex items-center gap-1.5 ml-auto">
        <span class="normal-case tracking-normal">Goats on the pitch:</span>
        {event.goats.map((g) => (
          <a href={`/goats/${g.slug}`} class="team-tag" style={`--tag:${g.accent}; --tag-fg:${textOn(g.accent)}`}>{g.shortName}</a>
        ))}
      </span>
    )}
  </div>
</div>

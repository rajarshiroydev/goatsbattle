---
/**
 * Shared page header — one consistent shape for every top-level page:
 * a bordered band with a soft accent wash, an optional breadcrumb, a mono
 * eyebrow, a big headline (lead + highlighted tail), and a subtitle.
 * A default slot renders extra content (stat rows, action buttons) below.
 */
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  breadcrumb?: Crumb[];
  /** Headline lead text (rendered in ink). */
  title: string;
  /** Highlighted tail of the headline, appended after a space. */
  highlight?: string;
  subtitle?: string;
  /** Accent colour for eyebrow + highlight. Defaults to the lime brand colour. */
  accent?: string;
  /** Tailwind max-width class for the header container. */
  maxW?: string;
}

const {
  eyebrow,
  breadcrumb,
  title,
  highlight,
  subtitle,
  accent,
  maxW = 'max-w-7xl',
} = Astro.props;

const accentColor = accent ?? 'var(--color-lime)';
const wash = accent
  ? `radial-gradient(ellipse 70% 60% at 50% -10%, ${accent}14 0%, transparent 60%)`
  : 'radial-gradient(ellipse 70% 60% at 50% -10%, rgba(200,255,0,0.08) 0%, transparent 60%)';
---

<section class="border-b border-hairline relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style={`background: ${wash}`}></div>
  <div class:list={['relative mx-auto px-5 py-14 md:py-20', maxW]}>

    {breadcrumb && breadcrumb.length > 0 && (
      <nav class="flex items-center gap-2 font-mono text-[13px] uppercase tracking-widest text-mute mb-6">
        {breadcrumb.map((c, i) => (
          <>
            {i > 0 && <span>/</span>}
            {c.href ? (
              <a href={c.href} class="hover:text-body transition-colors">{c.label}</a>
            ) : (
              <span class="text-ink">{c.label}</span>
            )}
          </>
        ))}
      </nav>
    )}

    {eyebrow && (
      <p class="font-mono text-sm uppercase tracking-widest mb-4" style={`color: ${accentColor}`}>{eyebrow}</p>
    )}

    <h1 class="font-headline font-black uppercase leading-[0.9] tracking-tight text-ink"
      style="font-size: clamp(3rem, 8vw, 6rem)">
      {title}{highlight && <> <span style={`color: ${accentColor}`}>{highlight}</span></>}
    </h1>

    {subtitle && (
      <p class="mt-5 font-sans text-body font-medium text-lg md:text-xl leading-relaxed max-w-2xl">{subtitle}</p>
    )}

    <slot />
  </div>
</section>

---
import type { BattleSummary } from '../lib/queries';
import { compactNumber } from '../lib/format';
import { arenaLabel, arenaEmoji } from '../data/arenas';

interface Props {
  battle: BattleSummary;
  /** Small mono label shown top-right, e.g. "Marquee" or "214K votes". */
  badge?: string;
}

const { battle, badge } = Astro.props;
const { a, b, slug, pctA, pctB, total, arena } = battle;
const hasVotes = total > 0;

// Marquee card (design §5 / screenshot 2): white names, lime champion (left) /
// red challenger (right), always. Name size scales with the card via container
// units so it stays on one line across the 3-up / 2-up grids.
function nameFont(name: string): string {
  const k = (46 / Math.max(name.length, 3)).toFixed(1);
  return `font-size: clamp(1.05rem, ${k}cqi, 1.7rem)`;
}
---

<a
  href={`/battle/${slug}`}
  class="@container group block bg-canvas-soft border border-hairline rounded-lg overflow-hidden hover:border-hairline-strong transition-colors"
>
  <!-- Header -->
  <div class="flex items-center justify-between px-4 py-3 border-b border-hairline">
    <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-mute">{arenaEmoji(arena)} {arenaLabel(arena)}</span>
    <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-mute">{badge ?? 'Marquee'}</span>
  </div>

  <!-- Body -->
  <div class="px-4 pt-4 pb-4">
    <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2">
      <div class="text-center min-w-0">
        <div class="font-headline font-black uppercase leading-none text-ink truncate" style={nameFont(a.shortName)}>{a.shortName}</div>
        {hasVotes && <div class="font-headline font-black text-[30px] leading-none text-lime mt-1.5">{pctA}%</div>}
      </div>
      <span class="font-headline font-black italic text-lg text-mute">VS</span>
      <div class="text-center min-w-0">
        <div class="font-headline font-black uppercase leading-none text-ink truncate" style={nameFont(b.shortName)}>{b.shortName}</div>
        {hasVotes && <div class="font-headline font-black text-[30px] leading-none text-red mt-1.5">{pctB}%</div>}
      </div>
    </div>

    {hasVotes ? (
      <>
        <div class="vote-bar mt-3.5" style={`--seg:${pctA}%`}>
          <div class="vote-seg-a"></div>
          <div class="vote-seg-b"></div>
        </div>
        <div class="flex justify-between mt-2.5">
          <span class="font-mono text-[11px] text-mute">{compactNumber(total)} votes</span>
          <span class="font-mono text-[11px] text-lime group-hover:text-ink transition-colors">Cast yours →</span>
        </div>
      </>
    ) : (
      <div class="flex justify-between items-center mt-4 pt-3.5 border-t border-hairline">
        <span class="font-mono text-[11px] uppercase tracking-wider text-mute">Be the first to vote</span>
        <span class="font-mono text-[11px] text-lime group-hover:text-ink transition-colors">Vote →</span>
      </div>
    )}
  </div>
</a>

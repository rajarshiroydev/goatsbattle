---
/**
 * A single take on The Floor (design §5 / 3a) — a compact, whole-row-clickable
 * comment surfaced from a battle. Until the matches API lands (which brings the
 * real Team/side tag), the leading tag shows the take's arena identity.
 */
import type { FloorTake } from '../lib/queries';
import { arenaLabel, arenaEmoji, getArena } from '../data/arenas';
import { compactNumber, relativeTime } from '../lib/format';

interface Props {
  take: FloorTake;
}

const { take } = Astro.props;
const accent = getArena(take.arena)?.accent ?? '#c8ff00';

/** Dark or light text for a solid tag background. */
function textOn(hex: string): string {
  const h = hex.replace('#', '');
  const r = parseInt(h.slice(0, 2), 16);
  const g = parseInt(h.slice(2, 4), 16);
  const b = parseInt(h.slice(4, 6), 16);
  return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.6 ? '#0d0d0f' : '#f0f0f2';
}
const tagFg = textOn(accent);
const context = `${arenaEmoji(take.arena)} ${take.a.shortName} vs ${take.b.shortName}`;
---

<a
  href={`/battle/${take.battleId}`}
  class="group flex items-center gap-3.5 bg-canvas-soft border border-hairline rounded-md px-[18px] py-[13px] hover:border-hairline-strong transition-colors"
>
  <span class="team-tag shrink-0" style={`--tag:${accent}; --tag-fg:${tagFg}`}>{arenaLabel(take.arena)}</span>

  <span class="flex-1 min-w-0 font-sans text-sm font-semibold text-ink truncate">{take.body}</span>

  <span class="hidden sm:flex items-center gap-1 font-mono text-[11px] text-mute shrink-0 whitespace-nowrap">
    {context} · {relativeTime(take.createdAt)}
  </span>
  {take.username && (
    <span class="hidden lg:inline font-sans text-[13px] font-semibold text-body shrink-0">@{take.username}</span>
  )}

  <span class="flex items-center gap-1 shrink-0 font-mono text-[11px] text-lime whitespace-nowrap">
    ▲ {compactNumber(take.upvotes)}
  </span>
</a>

---
/**
 * Visual + interactive match timeline (GBT-7). Plots each moment along a 0–90'+
 * track (home above the line, away below) and lists them below. Every moment is
 * clickable: it dispatches a `gb:moment` CustomEvent that the CommentThread
 * island listens for, so a reader can anchor their comment to that exact moment.
 * The list is the accessible, labelled interaction surface; markers mirror it.
 */
import type { MatchMoment } from '../lib/queries';

interface Props {
  moments: MatchMoment[];
  homeTeam: string;
  awayTeam: string;
}

const { moments, homeTeam, awayTeam } = Astro.props;

const GLYPH: Record<string, string> = {
  goal: '⚽', penalty: '⚽', own_goal: '⚽', penalty_missed: '❌',
  yellow_card: '🟨', red_card: '🟥', foul: '⚠️', handball: '✋',
  sub: '🔁', var: '📺', shootout: '🥅',
};
const TYPE_LABEL: Record<string, string> = {
  goal: 'Goal', penalty: 'Penalty', own_goal: 'Own goal', penalty_missed: 'Missed pen',
  yellow_card: 'Yellow card', red_card: 'Red card', foul: 'Foul', handball: 'Handball',
  sub: 'Sub', var: 'VAR', shootout: 'Shootout',
};
const glyph = (t: string) => GLYPH[t] ?? '•';
const typeLabel = (t: string) => TYPE_LABEL[t] ?? t.replace(/_/g, ' ');
const minuteLabel = (m: MatchMoment) => `${m.minute}${m.extra ? `+${m.extra}` : ''}'`;
const anchorLabel = (m: MatchMoment) => `${minuteLabel(m)} ${typeLabel(m.type)}`;

// Timeline runs to the last moment (min 90'). Position is a % of that span.
const maxMinute = Math.max(90, ...moments.map((m) => m.minute + (m.extra ?? 0)));
const pct = (m: MatchMoment) => Math.min(98, ((m.minute + (m.extra ?? 0)) / maxMinute) * 100);

const home = moments.filter((m) => m.team === 'home');
const away = moments.filter((m) => m.team === 'away');
---

<div class="bg-canvas-soft border border-hairline rounded-md p-4">
  <div class="flex items-center justify-between mb-3">
    <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-mute">Match timeline</span>
    <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-mute">{maxMinute}'</span>
  </div>

  {moments.length === 0 ? (
    <p class="font-sans text-sm text-mute py-4 text-center">No moments recorded for this match.</p>
  ) : (
    <div class="gb-timeline">
      {/* Track */}
      <div class="relative h-[92px] my-1" aria-hidden="true">
        {home.map((m) => (
          <button type="button" class="gb-moment absolute -translate-x-1/2 flex flex-col items-center gap-0.5"
            style={`left:${pct(m)}%; top:0`} data-moment-id={m.id} data-moment-label={anchorLabel(m)} title={m.detail ?? anchorLabel(m)}>
            <span class="text-[15px] leading-none">{glyph(m.type)}</span>
            <span class="font-mono text-[9px] text-mute">{minuteLabel(m)}</span>
          </button>
        ))}
        <div class="absolute left-0 right-0 top-1/2 h-px bg-hairline-strong"></div>
        <div class="absolute left-0 top-1/2 -translate-y-1/2 w-1.5 h-1.5 rounded-full" style="background: var(--color-lime)"></div>
        <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-1.5 rounded-full" style="background: var(--color-red)"></div>
        {away.map((m) => (
          <button type="button" class="gb-moment absolute -translate-x-1/2 flex flex-col items-center gap-0.5"
            style={`left:${pct(m)}%; bottom:0`} data-moment-id={m.id} data-moment-label={anchorLabel(m)} title={m.detail ?? anchorLabel(m)}>
            <span class="font-mono text-[9px] text-mute">{minuteLabel(m)}</span>
            <span class="text-[15px] leading-none">{glyph(m.type)}</span>
          </button>
        ))}
      </div>

      {/* Lane labels */}
      <div class="flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.12em] mb-3">
        <span class="text-lime">{homeTeam}</span>
        <span class="text-red">{awayTeam}</span>
      </div>

      {/* Clickable moment list — the primary "tag a moment" surface */}
      <ul class="flex flex-col gap-0.5 border-t border-hairline pt-2">
        {moments.map((m) => (
          <li>
            <button type="button"
              class="gb-moment w-full flex items-start gap-2 text-sm text-left rounded px-1.5 py-1 hover:bg-canvas transition-colors"
              data-moment-id={m.id} data-moment-label={anchorLabel(m)}
              title={`Tag this moment: ${anchorLabel(m)}`}>
              <span class="font-mono text-[11px] text-mute w-9 shrink-0 pt-0.5 text-right">{minuteLabel(m)}</span>
              <span class="shrink-0" aria-hidden="true">{glyph(m.type)}</span>
              <span class="sr-only">{m.team === 'home' ? homeTeam : awayTeam} — {typeLabel(m.type)}:</span>
              <span class="flex-1 min-w-0">
                <span class="font-sans font-semibold text-ink">{m.playerName ?? (m.team === 'home' ? homeTeam : awayTeam)}</span>
                {m.detail && <span class="font-sans text-body"> — {m.detail}</span>}
              </span>
              <span class="gb-tag-hint shrink-0 self-center font-mono text-[9px] uppercase tracking-wider text-lime opacity-0">Tag ⚑</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>

<style>
  .gb-moment { cursor: pointer; }
  .gb-moment:hover .gb-tag-hint,
  .gb-moment:focus-visible .gb-tag-hint { opacity: 1; }
  .gb-moment.is-active { background: rgba(200, 255, 0, 0.1); border-radius: 4px; }
  .gb-moment.is-active .gb-tag-hint { opacity: 1; }
</style>

<script>
  // Bridge the (static) timeline to the CommentThread island via window events.
  const moments = Array.from(document.querySelectorAll<HTMLElement>('.gb-moment[data-moment-id]'));

  function setActive(id: number | null) {
    for (const el of moments) {
      el.classList.toggle('is-active', id !== null && Number(el.dataset.momentId) === id);
    }
  }

  for (const el of moments) {
    el.addEventListener('click', () => {
      const id = Number(el.dataset.momentId);
      window.dispatchEvent(
        new CustomEvent('gb:moment', { detail: { id, label: el.dataset.momentLabel ?? '' } }),
      );
    });
  }

  // The island echoes selection/clear back so timeline + composer stay in sync.
  window.addEventListener('gb:moment', (e) => setActive((e as CustomEvent).detail?.id ?? null));
  window.addEventListener('gb:moment-clear', () => setActive(null));
</script>

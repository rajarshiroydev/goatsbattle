---
import type { Entity } from '../lib/types';
import { getTrophyEvents } from '../lib/compareViz';

interface Props {
  entityA: Entity;
  entityB: Entity;
}

const { entityA, entityB } = Astro.props;

const eventsA = getTrophyEvents(entityA);
const eventsB = getTrophyEvents(entityB);
const all = [...eventsA, ...eventsB];

const minYear = all.length ? Math.min(...all.map((e) => e.year)) : 0;
const maxYear = all.length ? Math.max(...all.map((e) => e.year)) : 0;
const span = Math.max(maxYear - minYear, 1);
const pct = (year: number) => ((year - minYear) / span) * 100;

// Decade ticks for the shared axis.
const firstTick = Math.ceil(minYear / 10) * 10;
const ticks: number[] = [];
for (let y = firstTick; y <= maxYear; y += 10) ticks.push(y);

const rows = [
  { entity: entityA, events: eventsA, color: '#c8ff00' },
  { entity: entityB, events: eventsB, color: '#3b82f6' },
];
const render = all.length > 0;
---

{render && (
  <section class="border-b border-hairline bg-canvas-soft">
    <div class="max-w-7xl mx-auto px-5 py-10">
      <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-3">
          <span class="w-0.5 h-5 bg-lime inline-block"></span>
          <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">Trophy Timeline</h2>
        </div>
        <span class="font-mono text-[10px] uppercase tracking-widest text-mute hidden sm:inline">{minYear}–{maxYear}</span>
      </div>

      <div class="space-y-8">
        {rows.map(({ entity, events, color }) => (
          <div>
            <div class="flex items-center gap-2 mb-4">
              <span class="w-2.5 h-2.5 rounded-sm inline-block" style={`background:${color}`}></span>
              <span class="font-headline font-black uppercase text-base text-ink">{entity.shortName}</span>
              <span class="font-mono text-[10px] uppercase tracking-widest text-mute">{events.length} titles</span>
            </div>

            <div class="relative h-12">
              <!-- Baseline -->
              <div class="absolute left-0 right-0 top-1/2 h-px bg-hairline"></div>
              <!-- Markers -->
              {events.map((ev) => (
                <span
                  class="group absolute top-1/2 -translate-x-1/2 -translate-y-1/2"
                  style={`left:${pct(ev.year)}%`}
                >
                  <span class="block w-2.5 h-2.5 rounded-full ring-2 ring-canvas-soft" style={`background:${color}`}></span>
                  <span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-2 whitespace-nowrap rounded-sm bg-canvas border border-hairline-strong px-2 py-1 font-sans text-[11px] text-ink opacity-0 group-hover:opacity-100 transition-opacity z-10">
                    {ev.title} · {ev.year}
                  </span>
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Shared year axis -->
      <div class="relative h-5 mt-2 border-t border-hairline">
        {ticks.map((year) => (
          <span class="absolute -translate-x-1/2 pt-1.5 font-mono text-[10px] text-mute" style={`left:${pct(year)}%`}>{year}</span>
        ))}
      </div>
    </div>
  </section>
)}

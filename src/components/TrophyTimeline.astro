---
import type { Entity } from '../lib/types';
import { getTrophyEvents } from '../lib/compareViz';

interface Props {
  entityA: Entity;
  entityB: Entity;
}

const { entityA, entityB } = Astro.props;

const eventsA = getTrophyEvents(entityA);
const eventsB = getTrophyEvents(entityB);
const all = [...eventsA, ...eventsB];
const render = all.length > 0;

// Bucket dated honours into decades so the eras are readable at a glance —
// a grouped bar per decade beats a cloud of hover-only dots.
const minYear = all.length ? Math.min(...all.map((e) => e.year)) : 0;
const maxYear = all.length ? Math.max(...all.map((e) => e.year)) : 0;
const startDecade = Math.floor(minYear / 10) * 10;
const endDecade = Math.floor(maxYear / 10) * 10;

const countIn = (events: { year: number }[], d: number) =>
  events.filter((e) => e.year >= d && e.year < d + 10).length;

const buckets: { decade: number; a: number; b: number }[] = [];
for (let d = startDecade; d <= endDecade; d += 10) {
  buckets.push({ decade: d, a: countIn(eventsA, d), b: countIn(eventsB, d) });
}
const maxCount = Math.max(1, ...buckets.map((x) => Math.max(x.a, x.b)));
const MAX_BAR = 132; // px

const totalA = eventsA.length;
const totalB = eventsB.length;

const players = [
  { entity: entityA, total: totalA, color: entityA.accent },
  { entity: entityB, total: totalB, color: entityB.accent },
];
---

{render && (
  <section class="border-b border-hairline bg-canvas-soft">
    <div class="max-w-7xl mx-auto px-5 py-10">
      <!-- Header + legend -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div class="flex items-center gap-3">
          <span class="w-1 h-6 inline-block rounded-full" style={`background:linear-gradient(${entityA.accent}, ${entityB.accent})`}></span>
          <h2 class="font-headline font-black uppercase text-2xl md:text-3xl tracking-tight text-ink">Trophies by Era</h2>
        </div>
        <div class="flex items-center gap-5">
          {players.map((p) => (
            <div class="flex items-center gap-2">
              <span class="w-3.5 h-3.5 rounded-sm inline-block" style={`background:${p.color}`}></span>
              <span class="font-headline font-black uppercase text-lg text-ink">{p.entity.shortName}</span>
              <span class="font-mono text-sm text-mute">{p.total}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Grouped bars per decade -->
      <div class="overflow-x-auto">
        <div class="flex items-end gap-4 sm:gap-6 min-w-max sm:min-w-0 px-1" style={`height:${MAX_BAR + 44}px`}>
          {buckets.map(({ decade, a, b }) => (
            <div class="flex-1 min-w-[64px] flex flex-col items-center justify-end h-full">
              <!-- bars -->
              <div class="flex items-end justify-center gap-1.5 w-full" style={`height:${MAX_BAR}px`}>
                <div class="flex flex-col items-center justify-end w-1/2 max-w-[34px] h-full">
                  {a > 0 && <span class="font-headline font-black text-lg leading-none mb-1" style={`color:${entityA.accent}`}>{a}</span>}
                  <div class="w-full rounded-t-sm transition-all" style={`height:${(a / maxCount) * MAX_BAR}px; background:${a > 0 ? entityA.accent : 'transparent'}; min-height:${a > 0 ? '4px' : '0'}`}></div>
                </div>
                <div class="flex flex-col items-center justify-end w-1/2 max-w-[34px] h-full">
                  {b > 0 && <span class="font-headline font-black text-lg leading-none mb-1" style={`color:${entityB.accent}`}>{b}</span>}
                  <div class="w-full rounded-t-sm transition-all" style={`height:${(b / maxCount) * MAX_BAR}px; background:${b > 0 ? entityB.accent : 'transparent'}; min-height:${b > 0 ? '4px' : '0'}`}></div>
                </div>
              </div>
              <!-- decade label -->
              <span class="mt-3 font-mono text-sm uppercase tracking-wider text-mute whitespace-nowrap">{`${decade}s`}</span>
            </div>
          ))}
        </div>
      </div>

      <p class="mt-6 font-mono text-xs uppercase tracking-widest text-mute">
        Major dated honours won each decade
      </p>
    </div>
  </section>
)}

---
import '../styles/global.css';
import AccountMenu from '../components/AccountMenu';
import AuthModal from '../components/AuthModal';

// Only offer the Google button when creds are configured server-side.
const googleEnabled = !!(
  (process.env.GOOGLE_CLIENT_ID ?? import.meta.env.GOOGLE_CLIENT_ID) &&
  (process.env.GOOGLE_CLIENT_SECRET ?? import.meta.env.GOOGLE_CLIENT_SECRET)
);

interface Props {
  title?: string;
  description?: string;
  /** Path to a share image (e.g. /og/battle/messi-vs-ronaldo.png). */
  image?: string;
}

const {
  title = "GOATSBattle — Who's the GOAT?",
  description = 'Vote on the greatest of all time. Compare stats. See who the world backs. Real-time GOAT rankings across sports, music, and culture.',
  image,
} = Astro.props;

// Resolve canonical + absolute image URLs against the configured site.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const imageURL = image ? new URL(image, Astro.site ?? Astro.url) : undefined;

// Primary nav — `match` marks the active tab (highlighted) via path prefix.
// Champion Mode lives behind the Play Now button, so it's off the centre nav.
const pathname = Astro.url.pathname;
const navLinks = [
  { href: '/floor', label: 'The Floor', match: ['/floor'] },
  { href: '/goats', label: 'Goats', match: ['/goats'] },
  { href: '/arenas', label: 'Arenas', match: ['/arenas'] },
  { href: '/rankings', label: 'Rankings', match: ['/rankings'] },
  { href: '/faceoff', label: 'Face Off', match: ['/faceoff'] },
];
const isActive = (m: string[]) =>
  m.some((p) => pathname === p || pathname.startsWith(`${p}/`));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageURL && (
      <>
        <meta property="og:image" content={imageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:image" content={imageURL} />
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,800;0,900;1,900&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-canvas text-ink min-h-screen flex flex-col">

    <!-- ── Site Header ── -->
    <header class="sticky top-0 z-50 border-b border-hairline bg-canvas/90 backdrop-blur-md">
      <nav class="page-container h-[60px] flex items-center justify-between gap-4">

        <!-- Logo -->
        <a href="/" class="shrink-0 font-headline font-black text-[21px] uppercase tracking-tight leading-none">
          GOATS<span class="text-lime">BATTLE</span>
        </a>

        <!-- Nav links (desktop) -->
        <div class="hidden md:flex items-center gap-1">
          {navLinks.map((link) => (
            <a href={link.href}
              class:list={[
                'font-sans text-sm font-medium px-[13px] py-[7px] rounded-md transition-colors',
                isActive(link.match)
                  ? 'text-lime bg-canvas-soft'
                  : 'text-body hover:text-ink hover:bg-canvas-soft',
              ]}
              aria-current={isActive(link.match) ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
        </div>

        <!-- CTA -->
        <div class="flex items-center gap-2.5 shrink-0">
          <a href="/play" class="btn btn-primary text-sm px-[18px] py-2">
            Play Now
          </a>
          <AccountMenu client:load />
        </div>

      </nav>
    </header>

    <!-- ── Page Content ── -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Shared auth modal (opened by any island via the authModal event bus) -->
    <AuthModal client:idle googleEnabled={googleEnabled} />

    <!-- ── Site Footer ── -->
    <footer class="border-t border-hairline bg-canvas-soft mt-auto">
      <div class="page-container py-12">
        <div class="flex flex-col md:flex-row items-start justify-between gap-8">

          <!-- Brand -->
          <div>
            <span class="font-headline font-black text-2xl uppercase tracking-tight leading-none">
              GOATS<span class="text-lime">BATTLE</span>
            </span>
            <p class="font-sans text-body text-sm mt-2">The Greatness Database.</p>
          </div>

          <!-- Links -->
          <div class="flex flex-wrap gap-10 font-sans text-sm">
            <div>
              <p class="font-mono text-[13px] uppercase tracking-widest text-mute mb-3">Platform</p>
              <ul class="space-y-2.5">
                <li><a href="/floor" class="text-body hover:text-ink transition-colors">The Floor</a></li>
                <li><a href="/goats" class="text-body hover:text-ink transition-colors">The Goats</a></li>
                <li><a href="/arenas" class="text-body hover:text-ink transition-colors">Arenas</a></li>
                <li><a href="/faceoff" class="text-body hover:text-ink transition-colors">Face Off</a></li>
                <li><a href="/play" class="text-body hover:text-ink transition-colors">Champion Mode</a></li>
              </ul>
            </div>
            <div>
              <p class="font-mono text-[13px] uppercase tracking-widest text-mute mb-3">Arenas</p>
              <ul class="space-y-2.5">
                <li><a href="/arenas/football" class="text-body hover:text-ink transition-colors">Football</a></li>
                <li><a href="/arenas/cricket" class="text-body hover:text-ink transition-colors">Cricket</a></li>
                <li><a href="/arenas/tennis" class="text-body hover:text-ink transition-colors">Tennis</a></li>
                <li><a href="/arenas/f1" class="text-body hover:text-ink transition-colors">Formula 1</a></li>
              </ul>
            </div>
            <div>
              <p class="font-mono text-[13px] uppercase tracking-widest text-mute mb-3">Developers</p>
              <ul class="space-y-2.5">
                <li><a href="/api" class="text-body hover:text-ink transition-colors">Public API</a></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-10 pt-6 border-t border-hairline flex flex-col sm:flex-row justify-between gap-3">
          <p class="font-sans text-mute text-sm">© 2026 GOATSBattle. All rights reserved.</p>
          <div class="flex gap-4 font-sans text-sm text-mute">
            <a href="#" class="hover:text-body transition-colors">Privacy</a>
            <a href="#" class="hover:text-body transition-colors">Terms</a>
            <a href="/api" class="hover:text-body transition-colors">API</a>
          </div>
        </div>
      </div>
    </footer>

  </body>
</html>

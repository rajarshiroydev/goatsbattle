---
import '../styles/global.css';
import { categories } from '../data/categories';

interface Props {
  title?: string;
  description?: string;
  /** Path to a share image (e.g. /og/battle/messi-vs-ronaldo.png). */
  image?: string;
}

const {
  title = "GOATSBattle — Who's the GOAT?",
  description = 'Vote on the greatest of all time. Compare stats. See who the world backs. Real-time GOAT rankings across sports, music, and culture.',
  image,
} = Astro.props;

// Resolve canonical + absolute image URLs against the configured site.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const imageURL = image ? new URL(image, Astro.site ?? Astro.url) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageURL && (
      <>
        <meta property="og:image" content={imageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:image" content={imageURL} />
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,800;0,900;1,800&family=DM+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-canvas text-ink min-h-screen flex flex-col">

    <!-- ── Site Header ── -->
    <header class="sticky top-0 z-50 border-b border-hairline bg-canvas/90 backdrop-blur-md">
      <nav class="max-w-7xl mx-auto px-5 h-14 flex items-center justify-between gap-4">

        <!-- Logo -->
        <a href="/" class="shrink-0 font-headline font-black text-xl uppercase tracking-tight leading-none">
          GOATS<span class="text-lime">BATTLE</span>
        </a>

        <!-- Nav links (desktop) -->
        <div class="hidden md:flex items-center gap-1">
          <a href="/goats"
            class="font-sans text-body text-sm px-3 py-1.5 rounded-md hover:text-ink hover:bg-canvas-soft transition-colors">
            Goats
          </a>
          <a href="/categories"
            class="font-sans text-body text-sm px-3 py-1.5 rounded-md hover:text-ink hover:bg-canvas-soft transition-colors">
            Categories
          </a>
          <a href="/faceoff"
            class="font-sans text-body text-sm px-3 py-1.5 rounded-md hover:text-ink hover:bg-canvas-soft transition-colors">
            Face Off
          </a>
          <a href="/play"
            class="font-sans text-body text-sm px-3 py-1.5 rounded-md hover:text-ink hover:bg-canvas-soft transition-colors">
            Champion Mode
          </a>

          <!-- Rankings — hover to pick an arena -->
          <div class="relative group">
            <button type="button"
              class="font-sans text-body text-sm px-3 py-1.5 rounded-md hover:text-ink group-hover:text-ink group-hover:bg-canvas-soft transition-colors">
              Rankings
            </button>
            <div class="absolute right-0 top-full pt-2 min-w-[13rem] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
              <div class="rounded-md border border-hairline bg-canvas shadow-xl overflow-hidden py-1">
                {categories.map((c) => (
                  <a href={`/rankings/${c.id}`}
                    class="flex items-center gap-2.5 px-3.5 py-2.5 hover:bg-canvas-soft transition-colors group/item">
                    <span class="text-base leading-none">{c.emoji}</span>
                    <span class="font-sans text-sm text-body group-hover/item:text-ink transition-colors">{c.label}</span>
                    <span class="ml-auto w-1 h-4 rounded-full" style={`background:${c.accent}`}></span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="flex items-center gap-2 shrink-0">
          <a href="/play"
            class="font-headline font-black uppercase text-sm tracking-wider bg-lime text-canvas px-4 h-8 flex items-center rounded-sm hover:bg-lime-dark transition-colors">
            Play Now
          </a>
        </div>

      </nav>
    </header>

    <!-- ── Page Content ── -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- ── Site Footer ── -->
    <footer class="border-t border-hairline bg-canvas-soft mt-auto">
      <div class="max-w-7xl mx-auto px-5 py-12">
        <div class="flex flex-col md:flex-row items-start justify-between gap-8">

          <!-- Brand -->
          <div>
            <span class="font-headline font-black text-xl uppercase tracking-tight leading-none">
              GOATS<span class="text-lime">BATTLE</span>
            </span>
            <p class="font-sans text-mute text-sm mt-2">The Internet's Greatness Database.</p>
          </div>

          <!-- Links -->
          <div class="flex flex-wrap gap-10 font-sans text-sm">
            <div>
              <p class="font-mono text-[11px] uppercase tracking-widest text-mute mb-3">Platform</p>
              <ul class="space-y-2">
                <li><a href="/goats" class="text-body hover:text-ink transition-colors">The Goats</a></li>
                <li><a href="/categories" class="text-body hover:text-ink transition-colors">Categories</a></li>
                <li><a href="/faceoff" class="text-body hover:text-ink transition-colors">Face Off</a></li>
                <li><a href="/play" class="text-body hover:text-ink transition-colors">Champion Mode</a></li>
              </ul>
            </div>
            <div>
              <p class="font-mono text-[11px] uppercase tracking-widest text-mute mb-3">Arenas</p>
              <ul class="space-y-2">
                <li><a href="/category/football" class="text-body hover:text-ink transition-colors">Football</a></li>
                <li><a href="/category/cricket" class="text-body hover:text-ink transition-colors">Cricket</a></li>
                <li><a href="/category/tennis" class="text-body hover:text-ink transition-colors">Tennis</a></li>
                <li><a href="/category/f1" class="text-body hover:text-ink transition-colors">Formula 1</a></li>
              </ul>
            </div>
            <div>
              <p class="font-mono text-[11px] uppercase tracking-widest text-mute mb-3">Developers</p>
              <ul class="space-y-2">
                <li><a href="/api" class="text-body hover:text-ink transition-colors">Public API</a></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-10 pt-6 border-t border-hairline flex flex-col sm:flex-row justify-between gap-3">
          <p class="font-sans text-mute text-xs">© 2026 GOATSBattle. All rights reserved.</p>
          <div class="flex gap-4 font-sans text-xs text-mute">
            <a href="#" class="hover:text-body transition-colors">Privacy</a>
            <a href="#" class="hover:text-body transition-colors">Terms</a>
            <a href="/api" class="hover:text-body transition-colors">API</a>
          </div>
        </div>
      </div>
    </footer>

  </body>
</html>

---
import Layout from '../../layouts/Layout.astro';
import { footballEntities, getEntityBySlug, getBattlesForEntity } from '../../data/football';

export function getStaticPaths() {
  return footballEntities.map(entity => ({
    params: { slug: entity.slug },
  }));
}

const { slug } = Astro.params;
const entity = getEntityBySlug(slug);

if (!entity) return Astro.redirect('/');

const entityBattles = getBattlesForEntity(slug);

const age = new Date().getFullYear() - new Date(entity.born).getFullYear();
const title = `${entity.name} | GOATSBattle`;
const description = `Is ${entity.name} the GOAT? Career stats, achievements, and head-to-head battles. Vote and see what the world thinks.`;
---

<Layout title={title} description={description}>

  <!-- Player Hero -->
  <section class="border-b border-hairline">
    <div class="max-w-7xl mx-auto px-5 py-12 md:py-16">

      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-mute mb-8">
        <a href="/" class="hover:text-body transition-colors">GOATSBattle</a>
        <span>/</span>
        <a href="/category/football" class="hover:text-body transition-colors">Football</a>
        <span>/</span>
        <span class="text-ink">{entity.shortName}</span>
      </div>

      <div class="flex flex-col lg:flex-row items-start gap-10">

        <!-- Avatar placeholder -->
        <div class="shrink-0 w-32 h-32 md:w-48 md:h-48 rounded-md bg-canvas-soft-2 border border-hairline flex items-center justify-center overflow-hidden">
          <span class="font-headline font-black text-6xl md:text-8xl text-mute leading-none select-none">
            {entity.shortName.charAt(0)}
          </span>
        </div>

        <!-- Info -->
        <div class="flex-1 min-w-0">

          <!-- Flag + nationality -->
          <div class="flex items-center gap-2 mb-3">
            <span class="font-mono text-[10px] uppercase tracking-widest text-lime">{entity.category}</span>
            <span class="text-mute">·</span>
            <span class="font-mono text-[10px] uppercase tracking-widest text-body">{entity.nationality}</span>
            {entity.active && (
              <span class="flex items-center gap-1 ml-2">
                <span class="w-1.5 h-1.5 rounded-full bg-lime inline-block animate-pulse"></span>
                <span class="font-mono text-[10px] uppercase tracking-wider text-lime">Active</span>
              </span>
            )}
          </div>

          <h1 class="font-headline font-black uppercase leading-none tracking-tight text-ink"
            style="font-size: clamp(2.5rem, 6vw, 5rem)">
            {entity.name}
          </h1>

          <div class="flex flex-wrap items-center gap-4 mt-3 font-sans text-sm text-body">
            <span>{entity.position}</span>
            <span class="text-hairline-strong">·</span>
            <span>Born {new Date(entity.born).getFullYear()}</span>
            <span class="text-hairline-strong">·</span>
            <span>{entity.active ? `Age ${age}` : `${new Date(entity.born).getFullYear()}–${entity.active ? 'present' : 'retired'}`}</span>
          </div>

          <p class="mt-5 font-sans text-body text-base leading-relaxed max-w-2xl">
            {entity.bio}
          </p>

          <!-- Quick CTA -->
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={`/battle/${entityBattles[0]?.battleSlug}`}
              class="font-headline font-black uppercase text-sm tracking-wider bg-lime text-canvas px-6 h-10 flex items-center rounded-sm hover:bg-lime-dark transition-colors whitespace-nowrap">
              Battle {entityBattles[0]?.opponent.shortName}
            </a>
            <a href="/play"
              class="font-sans font-medium text-sm text-ink border border-hairline-strong px-6 h-10 flex items-center rounded-sm hover:border-lime hover:text-lime transition-colors whitespace-nowrap">
              Champion Mode
            </a>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Achievements -->
  <section class="border-b border-hairline">
    <div class="max-w-7xl mx-auto px-5 py-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-0.5 h-5 bg-lime inline-block"></span>
        <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">Honours</h2>
      </div>
      <div class="flex flex-wrap gap-3">
        {entity.achievements.map(a => (
          <div class="flex items-center gap-2 bg-canvas-soft border border-hairline rounded-sm px-4 py-2">
            {a.count > 1 && (
              <span class="font-headline font-black text-lg leading-none text-lime">{a.count}×</span>
            )}
            <span class="font-sans text-sm text-ink">{a.title}</span>
            {a.years && a.years.length > 0 && (
              <span class="font-mono text-[10px] text-mute">
                ({a.years.join(', ')})
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Career Highlights -->
  <section class="border-b border-hairline bg-canvas-soft">
    <div class="max-w-7xl mx-auto px-5 py-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-0.5 h-5 bg-lime inline-block"></span>
        <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">Career Highlights</h2>
      </div>
      <ul class="space-y-3">
        {entity.careerHighlights.map(highlight => (
          <li class="flex items-start gap-3">
            <span class="font-headline font-black text-lime text-lg leading-none mt-0.5 shrink-0">/</span>
            <span class="font-sans text-base text-body leading-relaxed">{highlight}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Stats Sections -->
  {entity.statSections.map(section => (
    <section class="border-b border-hairline">
      <div class="max-w-7xl mx-auto px-5 py-10">
        <div class="flex items-center gap-3 mb-6">
          <span class="w-0.5 h-5 bg-lime inline-block"></span>
          <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">{section.heading}</h2>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
          {section.stats.map(stat => (
            <div class="bg-canvas-soft border border-hairline rounded-sm px-4 py-4">
              <p class="font-headline font-black text-3xl leading-none text-ink">{stat.value}{stat.unit}</p>
              <p class="font-sans text-xs text-mute mt-1 leading-snug">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Battles Involving This Player -->
  <section class="border-b border-hairline">
    <div class="max-w-7xl mx-auto px-5 py-12">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <span class="w-0.5 h-5 bg-lime inline-block"></span>
          <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">
            {entity.shortName} vs The World
          </h2>
        </div>
        <span class="font-mono text-[10px] uppercase tracking-widest text-mute">{entityBattles.length} battles</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {entityBattles.map(({ battleSlug, opponent }) => (
          <a href={`/battle/${battleSlug}`}
            class="group flex flex-col items-center gap-2 bg-canvas-soft border border-hairline hover:border-lime rounded-sm px-4 py-5 text-center transition-all duration-200">
            <span class="font-headline font-black text-2xl leading-none text-ink group-hover:text-lime transition-colors">
              {opponent.shortName}
            </span>
            <span class="font-mono text-[10px] uppercase tracking-wider text-mute">{opponent.nationality}</span>
            <span class="font-mono text-[10px] uppercase tracking-wider text-lime opacity-0 group-hover:opacity-100 transition-opacity">
              Vote →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

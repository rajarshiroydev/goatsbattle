---
import Layout from '../../layouts/Layout.astro';
import PlayerRank from '../../components/PlayerRank.tsx';
import ProfileVoteButton from '../../components/ProfileVoteButton.tsx';
import ContestedBattles from '../../components/ContestedBattles.tsx';
import { allEntities, getEntityBySlug } from '../../data';
import { categoryLabel } from '../../data/categories';

export function getStaticPaths() {
  return allEntities.map(entity => ({
    params: { slug: entity.slug },
  }));
}

const { slug } = Astro.params;
const entity = getEntityBySlug(slug);

if (!entity) return Astro.redirect('/');

const age = new Date().getFullYear() - new Date(entity.born).getFullYear();
const title = `${entity.name} | GOATSBattle`;
const description = `Is ${entity.name} the GOAT? Career stats, achievements, and head-to-head battles. Vote and see what the world thinks.`;

// The player's associated colour themes this whole page.
const accent = entity.accent;
---

<Layout title={title} description={description}>

  <!-- Player Hero -->
  <section class="border-b border-hairline relative">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style={`background: radial-gradient(ellipse 60% 70% at 12% 30%, ${accent}24 0%, transparent 60%)`}></div>
    <div class="relative max-w-7xl mx-auto px-5 py-12 md:py-16">

      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-mute mb-8">
        <a href="/" class="hover:text-body transition-colors">GOATSBattle</a>
        <span>/</span>
        <a href={`/category/${entity.category}`} class="hover:text-body transition-colors">{categoryLabel(entity.category)}</a>
        <span>/</span>
        <span class="text-ink">{entity.shortName}</span>
      </div>

      <div class="flex flex-col lg:flex-row items-start gap-10">

        <!-- Avatar placeholder — tinted with the player's colour -->
        <div class="shrink-0 w-32 h-32 md:w-48 md:h-48 rounded-md border flex items-center justify-center overflow-hidden"
          style={`background:${accent}1a; border-color:${accent}`}>
          <span class="font-headline font-black text-6xl md:text-8xl leading-none select-none" style={`color:${accent}`}>
            {entity.shortName.charAt(0)}
          </span>
        </div>

        <!-- Info -->
        <div class="flex-1 min-w-0">

          <!-- Flag + nationality -->
          <div class="flex items-center gap-2 mb-3">
            <span class="font-mono text-sm uppercase tracking-widest" style={`color:${accent}`}>{entity.category}</span>
            <span class="text-mute">·</span>
            <span class="font-mono text-sm uppercase tracking-widest text-body">{entity.nationality}</span>
            {entity.active && (
              <span class="flex items-center gap-1.5 ml-2">
                <span class="w-2 h-2 rounded-full inline-block animate-pulse" style={`background:${accent}`}></span>
                <span class="font-mono text-sm uppercase tracking-wider" style={`color:${accent}`}>Active</span>
              </span>
            )}
          </div>

          <h1 class="font-headline font-black uppercase leading-none tracking-tight text-ink"
            style="font-size: clamp(2.5rem, 6vw, 5rem)">
            {entity.name}
          </h1>

          <div class="flex flex-wrap items-center gap-4 mt-4 font-sans text-base text-body">
            <span>{entity.position}</span>
            <span class="text-hairline-strong">·</span>
            <span>Born {new Date(entity.born).getFullYear()}</span>
            <span class="text-hairline-strong">·</span>
            <span>{entity.active ? `Age ${age}` : `${new Date(entity.born).getFullYear()}–${entity.active ? 'present' : 'retired'}`}</span>
          </div>

          <p class="mt-6 font-sans text-body text-xl leading-relaxed max-w-2xl">
            {entity.bio}
          </p>

          <!-- Quick CTAs — cast a daily vote, or head to the battle builder -->
          <div class="mt-6 flex flex-wrap items-start gap-3">
            <ProfileVoteButton client:load id={entity.id} shortName={entity.shortName} accent={accent} />
            <a href={`/faceoff?goat=${entity.slug}`}
              class="font-sans text-lg border rounded-sm px-8 h-12 flex items-center gap-2 transition-colors whitespace-nowrap"
              style={`color:${accent}; border-color:${accent}40`}
              onmouseover={`this.style.borderColor='${accent}'`}
              onmouseout={`this.style.borderColor='${accent}40'`}>
              Face Off
              <span class="text-base">→</span>
            </a>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Global Standing — live score/rank/votes (hydrated client-side) -->
  <section class="border-b border-hairline bg-canvas-soft">
    <div class="max-w-7xl mx-auto px-5 py-10">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <span class="w-0.5 h-5 inline-block" style={`background:${accent}`}></span>
          <h2 class="font-headline font-black uppercase text-2xl md:text-3xl tracking-tight text-ink">Global Standing</h2>
        </div>
        <a href={`/rankings/${entity.category}`}
          class="font-mono text-xs uppercase tracking-widest text-mute hover:text-ink transition-colors">
          Full rankings →
        </a>
      </div>
      <PlayerRank client:load slug={entity.slug} category={entity.category} accent={accent} />
    </div>
  </section>

  <!-- Achievements -->
  <section class="border-b border-hairline">
    <div class="max-w-7xl mx-auto px-5 py-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-0.5 h-5 inline-block" style={`background:${accent}`}></span>
        <h2 class="font-headline font-black uppercase text-2xl md:text-3xl tracking-tight text-ink">Honours</h2>
      </div>
      <div class="flex flex-wrap gap-3">
        {entity.achievements.map(a => (
          <div class="flex items-center gap-2 bg-canvas-soft border border-hairline rounded-sm px-4 py-2.5" style={`border-color:${accent}33`}>
            {a.count > 1 && (
              <span class="font-headline font-black text-xl leading-none" style={`color:${accent}`}>{a.count}×</span>
            )}
            <span class="font-sans text-lg text-ink">{a.title}</span>
            {a.years && a.years.length > 0 && (
              <span class="font-mono text-xs text-mute">
                ({a.years.join(', ')})
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Career Highlights -->
  <section class="border-b border-hairline bg-canvas-soft">
    <div class="max-w-7xl mx-auto px-5 py-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-0.5 h-5 inline-block" style={`background:${accent}`}></span>
        <h2 class="font-headline font-black uppercase text-2xl md:text-3xl tracking-tight text-ink">Career Highlights</h2>
      </div>
      <ul class="space-y-4">
        {entity.careerHighlights.map(highlight => (
          <li class="flex items-start gap-3">
            <span class="font-headline font-black text-2xl leading-none mt-0.5 shrink-0" style={`color:${accent}`}>/</span>
            <span class="font-sans text-lg text-body leading-relaxed">{highlight}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Stats Sections -->
  {entity.statSections.map(section => (
    <section class="border-b border-hairline">
      <div class="max-w-7xl mx-auto px-5 py-10">
        <div class="flex items-center gap-3 mb-6">
          <span class="w-0.5 h-5 inline-block" style={`background:${accent}`}></span>
          <h2 class="font-headline font-black uppercase text-2xl md:text-3xl tracking-tight text-ink">{section.heading}</h2>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
          {section.stats.map(stat => (
            <div class="bg-canvas-soft border border-hairline rounded-md px-4 py-5 border-l-4" style={`border-left-color:${accent}`}>
              <p class="font-headline font-black text-4xl leading-none" style={`color:${accent}`}>{stat.value}{stat.unit}</p>
              <p class="font-sans text-base text-body mt-2 leading-snug">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Hottest Battles — this goat's most-contested live matchups -->
  <section class="border-b border-hairline">
    <div class="max-w-7xl mx-auto px-5 py-12">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <span class="w-0.5 h-5 inline-block" style={`background:${accent}`}></span>
          <h2 class="font-headline font-black uppercase text-2xl md:text-3xl tracking-tight text-ink">
            {entity.shortName}'s Hottest Battles
          </h2>
        </div>
        <span class="font-mono text-[11px] uppercase tracking-widest text-mute">Closest first</span>
      </div>
      <ContestedBattles client:load slug={entity.slug} accent={accent} />
    </div>
  </section>

</Layout>

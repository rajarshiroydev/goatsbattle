---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sign up — GOATSBattle" description="Create your GOATSBattle account to vote, comment, and earn your place among the defenders.">
  <section class="page-container py-24 text-center">
    <h1 class="font-headline font-black uppercase tracking-tight text-4xl md:text-5xl text-ink">
      Join <span class="text-lime">GOATSBattle</span>
    </h1>
    <p class="font-sans text-body text-lg mt-3">The greatness debate needs your voice. Create an account to vote & defend.</p>
    <button id="open-signup" class="btn btn-primary text-lg px-8 py-3.5 mt-8">
      Create account
    </button>
  </section>
</Layout>

<script>
  import { openAuthModal } from '../lib/authModal';
  const go = () => openAuthModal({ mode: 'signup' });
  go();
  document.getElementById('open-signup')?.addEventListener('click', go);
</script>

---
import Layout from '../layouts/Layout.astro';
import FloorFeed from '../components/FloorFeed.tsx';
import type { FloorFeedEvent } from '../components/FloorFeed.tsx';
import { archiveMatches } from '../data/archiveMatches';
import { worldCupEvents } from '../data/worldCupCatalog';

const events: FloorFeedEvent[] = [...worldCupEvents, ...archiveMatches].map((event) => ({
  ...event,
  kickoff: event.kickoff.toISOString(),
}));

const title = 'The Floor — Match Debates | GOATSBattle';
const description = 'The floor is open. Every match a GOAT played in, one debate at a time — follow the moment-by-moment timeline, back your GOAT, settle the greatness argument.';

---

<Layout title={title} description={description}>
  <FloorFeed client:load events={events} />
</Layout>

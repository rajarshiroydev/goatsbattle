---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — GOATSBattle" description="That GOATSBattle page could not be found.">
  <section class="page-container py-24 text-center">
    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-lime">404 · Full time</p>
    <h1 class="mt-3 font-headline font-black uppercase text-5xl sm:text-6xl text-ink">Nothing on this part of the floor</h1>
    <p class="mt-4 mx-auto max-w-xl font-sans text-body leading-relaxed">The link may be old, or the discussion may have moved. Head back to the World Cup hub or browse the GOAT rankings.</p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a href="/world-cup" class="btn btn-primary text-base px-6 py-3">World Cup hub</a>
      <a href="/rankings" class="btn btn-secondary text-base px-6 py-3">Browse rankings</a>
    </div>
  </section>
</Layout>

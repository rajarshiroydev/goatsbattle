---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { arenas } from '../../data/arenas';
import { getEntitiesByArena } from '../../data';
import { getAllBattleSummaries } from '../../lib/queries';
import { compactNumber } from '../../lib/format';

// Live — the inline marquee per arena reflects current tallies.
export const prerender = false;

const allSummaries = await getAllBattleSummaries();

const cards = arenas.map((c) => {
  const inArena = allSummaries.filter((b) => b.arena === c.id);
  const marquee = inArena.slice().sort((x, y) => y.total - x.total)[0] ?? null;
  return {
    ...c,
    legends: getEntitiesByArena(c.id).length,
    battles: inArena.length,
    marquee,
  };
});

const title = 'Arenas — Every GOAT Arena | GOATSBattle';
const description = 'Football, cricket, tennis, Formula 1 and more. Pick an arena and see the live GOAT rankings decided by the world.';
---

<Layout title={title} description={description}>

  <PageHero
    title="Pick your"
    highlight="arena"
    description="Every sport has its eternal argument. Choose an arena to see the community-voted rankings — and settle the debate yourself." />

  <section class="pt-8 pb-12">
    <div class="page-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {cards.map((c) => (
          <a href={`/arenas/${c.id}`}
            class="group block bg-canvas-soft border border-hairline rounded-md p-[22px] transition-colors"
            style={`background-image: linear-gradient(140deg, ${c.accent}12, transparent 55%)`}
            onmouseover={`this.style.borderColor='${c.accent}'`}
            onmouseout={`this.style.borderColor=''`}>

            <!-- Arena title row -->
            <div class="flex items-baseline gap-2.5">
              <span class="font-headline font-black uppercase text-3xl md:text-[34px] leading-none text-ink">{c.label}</span>
              <span class="text-[22px] leading-none">{c.emoji}</span>
              <span class="ml-auto font-mono text-[10px] uppercase tracking-[0.12em] flex items-center gap-1.5" style={`color:${c.accent}`}>
                <span class="w-1.5 h-1.5 rounded-full inline-block" style={`background:${c.accent}`}></span>
                {c.legends} goats · {c.battles} battles
              </span>
            </div>

            <!-- Inline marquee -->
            <div class="mt-4 bg-sunken border border-hairline rounded-md px-3.5 py-3">
              {c.marquee ? (
                <>
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-mute">Marquee</span>
                    <span class="ml-auto font-mono text-[9px] text-mute">
                      {c.marquee.total > 0 ? `${compactNumber(c.marquee.total)} votes` : 'no votes yet'}
                    </span>
                  </div>
                  <div class="flex items-center gap-2.5 mt-2">
                    <span class="font-headline font-black uppercase text-xl leading-none text-ink truncate">{c.marquee.a.shortName}</span>
                    {c.marquee.total > 0 && <span class="font-headline font-black text-[15px] text-lime">{c.marquee.pctA}</span>}
                    <span class="font-headline font-black italic text-[13px] text-mute">VS</span>
                    {c.marquee.total > 0 && <span class="font-headline font-black text-[15px] text-red">{c.marquee.pctB}</span>}
                    <span class="font-headline font-black uppercase text-xl leading-none text-ink truncate">{c.marquee.b.shortName}</span>
                  </div>
                  <div class="vote-bar mt-2.5" style={`--seg:${c.marquee.total > 0 ? c.marquee.pctA : 50}%; height:4px`}>
                    <div class="vote-seg-a"></div>
                    <div class="vote-seg-b"></div>
                  </div>
                </>
              ) : (
                <span class="font-mono text-[11px] uppercase tracking-wider text-mute">Battles opening soon</span>
              )}
            </div>

            <!-- Footer -->
            <div class="flex items-center mt-3.5">
              <span class="font-sans text-[13px] text-mute">{c.tagline}</span>
              <span class="ml-auto font-mono text-[11px] uppercase tracking-[0.12em] transition-transform group-hover:translate-x-0.5" style={`color:${c.accent}`}>Enter →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import BattleCard from '../../components/BattleCard.astro';
import { getRoster } from '../../data';
import { getArena, arenas } from '../../data/arenas';
import { getStaticBattleSummaries } from '../../lib/staticCatalog';
import { flagEmoji, compactNumber } from '../../lib/format';

/** Dark or light text on a solid accent chip. */
function onAccent(hex: string): string {
  const h = hex.replace('#', '');
  return (0.299 * parseInt(h.slice(0, 2), 16) + 0.587 * parseInt(h.slice(2, 4), 16) + 0.114 * parseInt(h.slice(4, 6), 16)) / 255 > 0.6 ? '#0d0d0f' : '#f0f0f2';
}

export function getStaticPaths() {
  return arenas.map((item) => ({ params: { arena: item.id } }));
}

const { arena } = Astro.params;
const cat = arena ? getArena(arena) : undefined;
if (!arena || !cat) return new Response('Not found', { status: 404 });

const allBattles = getStaticBattleSummaries(arena);
const roster = getRoster(arena);
const totalVotes = allBattles.reduce((s, b) => s + b.total, 0);
const accent = cat.accent;

const title = `${cat.label} GOAT Battles — Every Matchup | GOATSBattle`;
const description = `Every ${cat.label} GOAT battle and the legends behind them. Compare stats head-to-head and vote on who the world thinks is the greatest of all time.`;
---

<Layout title={title} description={description}>

  <!-- Header -->
  <SectionHeader
    title={cat.label}
    highlight="Arena"
    accent={accent}
    live={totalVotes > 0}
    stat={`${allBattles.length} battles · ${roster.length} legends · ${totalVotes > 0 ? `${compactNumber(totalVotes)} votes` : 'voting open'}`}>
    <div slot="chips">
      {arenas.map((c) => {
        const on = c.id === arena;
        return (
          <a href={`/arenas/${c.id}`} class={`chip${on ? ' chip-active' : ''}`}
            style={on ? `background:${c.accent}; border-color:${c.accent}; color:${onAccent(c.accent)}` : ''}>
            {c.emoji} {c.label}
          </a>
        );
      })}
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`/rankings/${arena}`} class="btn text-sm px-6 py-3" style={`background:${accent}; color:${onAccent(accent)}`}>
        View {cat.label} Rankings
      </a>
      <a href="/arenas" class="btn btn-secondary text-sm px-6 py-3">All Arenas</a>
    </div>
  </SectionHeader>

  <!-- Players roster -->
  <section class="border-b border-hairline bg-canvas-soft mt-8">
    <div class="page-container py-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-0.5 h-5 inline-block" style={`background:${accent}`}></span>
        <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">The Legends</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {roster.map((e) => (
          <a href={`/goats/${e.slug}`}
            class="arena-goat group flex items-center gap-3 bg-canvas border rounded-md px-4 py-3 transition-colors"
            style={`--goat-accent:${e.accent}; border-color:${e.accent}33`}>
            <span class="text-2xl leading-none">{flagEmoji(e.countryCode)}</span>
            <span class="min-w-0">
              <span class="block font-headline font-black uppercase text-xl leading-none truncate" style={`color:${e.accent}`}>{e.shortName}</span>
              <span class="block font-mono text-[13px] uppercase tracking-wider text-mute mt-1">{e.position}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- All battles -->
  <section>
    <div class="page-container py-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-0.5 h-5 inline-block" style={`background:${accent}`}></span>
        <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">All Battles</h2>
        <span class="font-mono text-[13px] uppercase tracking-widest text-mute hidden sm:inline">Sorted by votes</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {allBattles.map((battle) => (
          <BattleCard battle={battle} badge={battle.total > 0 ? `${compactNumber(battle.total)} votes` : undefined} />
        ))}
      </div>
    </div>
  </section>

  <style>
    .arena-goat:hover { border-color: var(--goat-accent); }
  </style>

</Layout>

---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BattleCard from '../../components/BattleCard.astro';
import { getRoster } from '../../data';
import { getArena } from '../../data/arenas';
import { getAllBattleSummaries } from '../../lib/queries';
import { flagEmoji, compactNumber } from '../../lib/format';

// Live catalog — ordering follows community votes.
export const prerender = false;

const { arena } = Astro.params;
const cat = arena ? getArena(arena) : undefined;
if (!arena || !cat) return new Response('Not found', { status: 404 });

const allBattles = await getAllBattleSummaries(arena);
const roster = getRoster(arena);
const totalVotes = allBattles.reduce((s, b) => s + b.total, 0);
const accent = cat.accent;

const title = `${cat.label} GOAT Battles — Every Matchup | GOATSBattle`;
const description = `Every ${cat.label} GOAT battle and the legends behind them. Compare stats head-to-head and vote on who the world thinks is the greatest of all time.`;
---

<Layout title={title} description={description}>

  <!-- Header -->
  <PageHeader
    accent={accent}
    breadcrumb={[
      { label: 'GOATSBattle', href: '/' },
      { label: 'Arenas', href: '/arenas' },
      { label: cat.label },
    ]}
    title={cat.label}
    highlight="Arena"
    subtitle={`${allBattles.length} battles · ${roster.length} legends · ${totalVotes > 0 ? `${compactNumber(totalVotes)} votes cast` : 'voting just opened'}.`}>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`/rankings/${arena}`}
        class="font-headline font-black uppercase tracking-wider text-sm px-6 h-11 flex items-center rounded-sm transition-opacity hover:opacity-90"
        style={`background:${accent}; color:#0d0d0f`}>
        View {cat.label} Rankings
      </a>
      <a href="/arenas"
        class="font-sans text-sm text-ink border border-hairline-strong px-6 h-11 flex items-center rounded-sm hover:border-ink transition-colors">
        All Arenas
      </a>
    </div>
  </PageHeader>

  <!-- Players roster -->
  <section class="border-b border-hairline bg-canvas-soft">
    <div class="max-w-7xl mx-auto px-5 py-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-0.5 h-5 inline-block" style={`background:${accent}`}></span>
        <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">The Legends</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {roster.map((e) => (
          <a href={`/goats/${e.slug}`}
            class="group flex items-center gap-3 bg-canvas border rounded-md px-4 py-3 transition-colors"
            style={`border-color:${e.accent}33`}
            onmouseover={`this.style.borderColor='${e.accent}'`}
            onmouseout={`this.style.borderColor='${e.accent}33'`}>
            <span class="text-2xl leading-none">{flagEmoji(e.countryCode)}</span>
            <span class="min-w-0">
              <span class="block font-headline font-black uppercase text-xl leading-none truncate" style={`color:${e.accent}`}>{e.shortName}</span>
              <span class="block font-mono text-[13px] uppercase tracking-wider text-mute mt-1">{e.position}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- All battles -->
  <section>
    <div class="max-w-7xl mx-auto px-5 py-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-0.5 h-5 inline-block" style={`background:${accent}`}></span>
        <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">All Battles</h2>
        <span class="font-mono text-[13px] uppercase tracking-widest text-mute hidden sm:inline">Sorted by votes</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {allBattles.map((battle) => (
          <BattleCard battle={battle} badge={battle.total > 0 ? `${compactNumber(battle.total)} votes` : undefined} />
        ))}
      </div>
    </div>
  </section>

</Layout>

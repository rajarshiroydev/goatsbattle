---
import Layout from '../../layouts/Layout.astro';
import { getRankings } from '../../lib/queries';
import { flagEmoji, compactNumber } from '../../lib/format';

// Live leaderboard — recompute ranks on every request.
export const prerender = false;

const { category } = Astro.params;

// Football is the only live arena at launch; anything else 404s cleanly.
const CATEGORY_LABELS: Record<string, string> = { football: 'Football' };
const label = category ? CATEGORY_LABELS[category] : undefined;
if (!category || !label) return new Response('Not found', { status: 404 });

const rankings = await getRankings(category);
const totalVotes = rankings.reduce((s, r) => s + r.totalVotes, 0);
const [top1, top2, top3] = rankings;

const title = `${label} GOAT Rankings — Live Score Leaderboard | GOATSBattle`;
const description = `The live ${label.toLowerCase()} GOAT leaderboard, ranked by community-voted score. See who the world crowns the greatest of all time.`;
---

<Layout title={title} description={description}>

  <!-- ══ Header ══ -->
  <section class="border-b border-hairline relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(ellipse 70% 60% at 50% -10%, rgba(200,255,0,0.08) 0%, transparent 60%)">
    </div>
    <div class="relative max-w-5xl mx-auto px-5 py-12 md:py-16">
      <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-mute mb-6">
        <a href="/" class="hover:text-body transition-colors">GOATSBattle</a>
        <span>/</span>
        <a href={`/category/${category}`} class="hover:text-body transition-colors">{label}</a>
        <span>/</span>
        <span class="text-ink">Rankings</span>
      </div>

      <div class="inline-flex items-center gap-2 mb-5">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-lime opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-lime"></span>
        </span>
        <span class="font-mono text-[11px] uppercase tracking-widest text-body">Live Score · Community-voted</span>
      </div>

      <h1 class="font-headline font-black uppercase leading-[0.9] tracking-tight text-ink"
        style="font-size: clamp(3rem, 9vw, 6rem)">
        {label} <span class="text-lime">Rankings</span>
      </h1>
      <p class="mt-5 font-sans text-body text-base leading-relaxed max-w-lg">
        Every vote is a 1v1 match. Each player's score starts at 1500 and moves with the crowd —
        this is the greatest-of-all-time order as the world sees it right now.
      </p>

      <div class="mt-8 flex flex-wrap gap-8">
        {[
          { stat: String(rankings.length), label: 'GOATs ranked' },
          { stat: totalVotes > 0 ? compactNumber(totalVotes) : '—', label: 'Votes counted' },
          { stat: top1 ? top1.entity.shortName : '—', label: 'Current #1' },
        ].map(({ stat, label }) => (
          <div>
            <p class="font-headline font-black text-3xl leading-none tracking-tight text-lime">{stat}</p>
            <p class="font-mono text-[11px] uppercase tracking-widest text-mute mt-1.5">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ Podium (top 3) ══ -->
  {top1 && (
    <section class="border-b border-hairline bg-canvas-soft">
      <div class="max-w-5xl mx-auto px-5 py-10">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {[top2, top1, top3].map((r, col) => r && (
            <a href={`/player/${r.entity.slug}`}
              class={`group relative flex flex-col items-center text-center rounded-md border px-5 py-6 transition-all duration-200 ${
                r.rank === 1
                  ? 'border-lime bg-lime/5 sm:-translate-y-3'
                  : 'border-hairline bg-canvas hover:border-hairline-strong'
              }`}>
              <span class={`font-headline font-black leading-none ${r.rank === 1 ? 'text-lime text-5xl' : 'text-mute text-4xl'}`}>
                {r.rank === 1 ? '🏆' : `#${r.rank}`}
              </span>
              <span class="mt-3 font-headline font-black uppercase text-2xl leading-none tracking-tight text-ink group-hover:text-lime transition-colors">
                {r.entity.shortName}
              </span>
              <span class="mt-1.5 font-sans text-sm text-body">{flagEmoji(r.entity.countryCode)} {r.entity.nationality}</span>
              <span class="mt-3 font-headline font-black text-2xl leading-none" style={`color:${r.entity.accent}`}>{r.elo.toLocaleString()}</span>
              <span class="font-mono text-[11px] uppercase tracking-widest text-mute mt-0.5">Score</span>
              {r.totalVotes > 0 && (
                <span class="font-mono text-[11px] uppercase tracking-wider text-mute mt-1.5">{compactNumber(r.totalVotes)} votes · {r.winRate}% win</span>
              )}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══ Full leaderboard ══ -->
  <section>
    <div class="max-w-5xl mx-auto px-5 py-10">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-0.5 h-5 bg-lime inline-block"></span>
        <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">Full Table</h2>
      </div>

      <!-- Column labels (desktop) -->
      <div class="hidden md:grid grid-cols-[3rem_1fr_5rem_6rem_9rem] gap-4 px-4 pb-3 font-mono text-[11px] uppercase tracking-widest text-mute">
        <span>Rank</span>
        <span>Player</span>
        <span class="text-right">Score</span>
        <span class="text-right">Votes</span>
        <span class="text-right">Win Rate</span>
      </div>

      <div class="space-y-1.5">
        {rankings.map((r) => (
          <a href={`/player/${r.entity.slug}`}
            class={`group grid grid-cols-[2.5rem_1fr_auto] md:grid-cols-[3rem_1fr_5rem_6rem_9rem] items-center gap-3 md:gap-4 rounded-sm border px-4 py-3.5 transition-all duration-200 ${
              r.rank <= 3 ? 'border-hairline-strong bg-canvas-soft' : 'border-hairline bg-canvas-soft hover:border-hairline-strong'
            }`}>
            <!-- Rank -->
            <span class={`font-headline font-black text-2xl leading-none ${r.rank <= 3 ? 'text-lime' : 'text-mute'}`}>
              {r.rank}
            </span>

            <!-- Player -->
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="w-1 h-4 rounded-full shrink-0" style={`background:${r.entity.accent}`}></span>
                <span class="font-headline font-black uppercase text-lg leading-none tracking-tight text-ink group-hover:text-lime transition-colors truncate">
                  {r.entity.shortName}
                </span>
                <span class="text-sm shrink-0">{flagEmoji(r.entity.countryCode)}</span>
              </div>
              <span class="font-sans text-sm text-mute">{r.entity.nationality} · {r.entity.position}</span>
            </div>

            <!-- Score (mobile shows here compactly on the right) -->
            <span class="md:text-right font-headline font-black text-xl leading-none text-right" style={`color:${r.entity.accent}`}>
              {r.elo.toLocaleString()}
              <span class="md:hidden font-mono text-[11px] uppercase tracking-widest text-mute ml-1">Pts</span>
            </span>

            <!-- Total votes -->
            <span class="hidden md:block text-right font-mono text-sm text-body">
              {r.totalVotes > 0 ? compactNumber(r.totalVotes) : '—'}
            </span>

            <!-- Win rate bar -->
            <div class="hidden md:flex items-center gap-2 justify-end">
              <div class="w-16 h-1.5 rounded-full bg-hairline overflow-hidden">
                <div class="h-full" style={`width:${r.totalVotes > 0 ? r.winRate : 0}%; background:${r.entity.accent}`}></div>
              </div>
              <span class="w-9 text-right font-mono text-sm text-body">{r.totalVotes > 0 ? `${r.winRate}%` : '—'}</span>
            </div>
          </a>
        ))}
      </div>

      <p class="mt-6 font-mono text-[11px] uppercase tracking-widest text-mute">
        Scores update instantly with every vote · seeded at 1500
      </p>
    </div>
  </section>

  <!-- ══ CTA ══ -->
  <section class="border-t border-hairline bg-canvas-soft">
    <div class="max-w-5xl mx-auto px-5 py-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <h2 class="font-headline font-black uppercase text-2xl tracking-tight text-ink">Think the order's wrong?</h2>
        <p class="mt-2 font-sans text-body text-sm">Pick your GOAT and move the rankings yourself.</p>
      </div>
      <a href="/play"
        class="font-headline font-black uppercase tracking-wider text-base bg-lime text-canvas px-8 h-12 flex items-center rounded-sm hover:bg-lime-dark transition-colors whitespace-nowrap">
        Enter Champion Mode
      </a>
    </div>
  </section>

</Layout>

---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { arenas } from '../../data/arenas';
import { getEntitiesByArena } from '../../data';

const cards = arenas.map((c) => ({
  ...c,
  legends: getEntitiesByArena(c.id).length,
}));

const title = 'Rankings — Live GOAT Leaderboards | GOATSBattle';
const description = 'Pick an arena and see its live, community-voted GOAT rankings. Football, cricket, tennis and Formula 1 — the greatest of all time, decided by the world.';
---

<Layout title={title} description={description}>

  <!-- Header -->
  <PageHeader
    title="GOAT"
    highlight="Rankings"
    subtitle="Pick an arena to see its live, community-voted leaderboard — the greatest of all time, ranked by the world right now." />

  <!-- Arena grid → each opens that arena's rankings -->
  <section>
    <div class="max-w-7xl mx-auto px-5 py-12 md:py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {cards.map((c) => (
          <a href={`/rankings/${c.id}`}
            class="group relative flex flex-col justify-between overflow-hidden rounded-lg border border-hairline bg-canvas-soft p-7 md:p-9 min-h-[220px] transition-all duration-200 hover:-translate-y-1"
            style={`box-shadow: var(--shadow-card)`}
            onmouseover={`this.style.borderColor='${c.accent}'`}
            onmouseout={`this.style.borderColor=''`}>

            <!-- Colour wash -->
            <div class="absolute inset-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300"
              aria-hidden="true"
              style={`background: radial-gradient(ellipse 70% 90% at 100% 0%, ${c.accent}20 0%, transparent 60%)`}></div>

            <div class="relative flex items-start justify-between">
              <div>
                <span class="font-mono text-[13px] uppercase tracking-widest" style={`color:${c.accent}`}>{c.debate}</span>
                <h2 class="mt-3 font-headline font-black uppercase leading-none tracking-tight text-ink group-hover:opacity-95"
                  style="font-size: clamp(2.5rem, 6vw, 4rem)">
                  {c.label}
                </h2>
                <p class="mt-3 font-sans text-body text-base max-w-sm">{c.tagline}</p>
              </div>
              <span class="text-5xl md:text-6xl leading-none shrink-0" style={`filter: drop-shadow(0 0 20px ${c.accent}55)`}>{c.emoji}</span>
            </div>

            <div class="relative mt-6 flex items-center justify-between">
              <div class="flex items-center gap-5 font-mono text-[13px] uppercase tracking-wider text-mute">
                <span><span class="text-ink font-bold">{c.legends}</span> legends ranked</span>
              </div>
              <span class="font-headline font-black uppercase text-sm tracking-wider transition-transform group-hover:translate-x-1" style={`color:${c.accent}`}>
                View Rankings →
              </span>
            </div>
          </a>
        ))}
      </div>

      <p class="mt-8 font-mono text-[13px] uppercase tracking-widest text-mute text-center">
        Ranked purely by votes · +1 from a profile vote, +5 for winning Champion Mode
      </p>
    </div>
  </section>

</Layout>

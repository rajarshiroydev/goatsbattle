---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { arenas } from '../../data/arenas';
import { getEntitiesByArena } from '../../data';

const cards = arenas.map((c) => ({
  ...c,
  legends: getEntitiesByArena(c.id).length,
}));

const title = 'Rankings — Live GOAT Leaderboards | GOATSBattle';
const description = 'Pick an arena and see its live, community-voted GOAT rankings. Football, cricket, tennis and Formula 1 — the greatest of all time, decided by the world.';
---

<Layout title={title} description={description}>

  <PageHero
    title="GOAT"
    highlight="Rankings"
    description="Pick an arena to see its live, community-voted leaderboard — the greatest of all time, ranked by the world right now." />

  <section class="pt-8 pb-12">
    <div class="page-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {cards.map((c) => (
          <a href={`/rankings/${c.id}`}
            class="group block bg-canvas-soft border border-hairline rounded-md p-[22px] transition-colors"
            style={`background-image: linear-gradient(140deg, ${c.accent}12, transparent 55%)`}
            onmouseover={`this.style.borderColor='${c.accent}'`}
            onmouseout={`this.style.borderColor=''`}>
            <div class="flex items-baseline gap-2.5">
              <span class="font-headline font-black uppercase text-3xl md:text-[34px] leading-none text-ink">{c.label}</span>
              <span class="text-[22px] leading-none">{c.emoji}</span>
              <span class="ml-auto font-mono text-[10px] uppercase tracking-[0.12em] flex items-center gap-1.5" style={`color:${c.accent}`}>
                <span class="w-1.5 h-1.5 rounded-full inline-block" style={`background:${c.accent}`}></span>
                {c.legends} goats ranked
              </span>
            </div>
            <div class="flex items-center mt-5">
              <span class="font-sans text-[13px] text-mute">{c.debate}</span>
              <span class="ml-auto font-mono text-[11px] uppercase tracking-[0.12em] transition-transform group-hover:translate-x-0.5" style={`color:${c.accent}`}>View rankings →</span>
            </div>
          </a>
        ))}
      </div>

      <p class="mt-8 font-mono text-[13px] uppercase tracking-widest text-mute text-center">
        Ranked purely by votes · +1 from a profile vote, +5 for winning Champion Mode
      </p>
    </div>
  </section>

</Layout>

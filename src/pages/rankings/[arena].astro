---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getStaticRankings } from '../../lib/staticCatalog';
import { getArena, arenas } from '../../data/arenas';
import { flagEmoji, compactNumber } from '../../lib/format';
import H2HPopover from '../../components/H2HPopover.tsx';

export function getStaticPaths() {
  return arenas.map((item) => ({ params: { arena: item.id } }));
}

/** Dark or light text on a solid accent chip. */
function onAccent(hex: string): string {
  const h = hex.replace('#', '');
  return (0.299 * parseInt(h.slice(0, 2), 16) + 0.587 * parseInt(h.slice(2, 4), 16) + 0.114 * parseInt(h.slice(4, 6), 16)) / 255 > 0.6 ? '#0d0d0f' : '#f0f0f2';
}

const { arena } = Astro.params;
const cat = arena ? getArena(arena) : undefined;
if (!arena || !cat) return new Response('Not found', { status: 404 });
const label = cat.label;

const rankings = getStaticRankings(arena);
const totalVotes = rankings.reduce((s, r) => s + r.votes, 0);
const [top1, top2, top3] = rankings;

const ticker = [
  { stat: String(rankings.length), label: 'Goats ranked' },
  { stat: totalVotes > 0 ? compactNumber(totalVotes) : '—', label: 'Votes counted' },
  { stat: top1 ? top1.entity.shortName : '—', label: 'Current #1' },
];

const title = `${label} GOAT Rankings — Live Vote Leaderboard | GOATSBattle`;
const description = `The live ${label.toLowerCase()} GOAT leaderboard, ranked by community votes. See who the world crowns the greatest of all time.`;

const cols = 'grid-cols-[2.5rem_1fr_auto] md:grid-cols-[3rem_1fr_5rem_6rem_9rem]';
---

<Layout title={title} description={description}>

  <!-- ══ Hero ══ -->
  <PageHero
    title={label}
    highlight="Rankings"
    description="Ranked purely by votes — +1 from a profile vote, +5 for winning Champion Mode. This is the greatest-of-all-time order as the world sees it right now.">

    <!-- Arena switch -->
    <div class="mt-7 flex flex-wrap items-center gap-1.5">
      {arenas.map((c) => {
        const on = c.id === arena;
        return (
          <a href={`/rankings/${c.id}`} class={`chip${on ? ' chip-active' : ''}`}
            style={on ? `background:${c.accent}; border-color:${c.accent}; color:${onAccent(c.accent)}` : ''}>
            {c.emoji} {c.label}
          </a>
        );
      })}
    </div>

    <!-- Stat ticker -->
    <div class="mt-8 flex flex-wrap gap-8 md:gap-12">
      {ticker.map(({ stat, label }) => (
        <div>
          <p class="font-headline font-black text-3xl leading-none tracking-tight text-lime">{stat}</p>
          <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-mute mt-2">{label}</p>
        </div>
      ))}
    </div>
  </PageHero>

  <!-- ══ Podium (top 3) ══ -->
  {top1 && (
    <section class="border-b border-hairline bg-canvas-soft">
      <div class="page-container py-10">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-end">
          {[top2, top1, top3].map((r) => r && (
            <a href={`/goats/${r.entity.slug}`}
              class={`group relative flex flex-col items-center text-center rounded-md border px-5 py-6 transition-colors ${
                r.rank === 1
                  ? 'border-lime sm:pb-8'
                  : 'border-hairline hover:border-hairline-strong'
              }`}
              style={r.rank === 1 ? 'background: linear-gradient(180deg, rgba(198,255,0,0.07), transparent 70%)' : 'background: var(--color-canvas)'}>
              <span class={`font-headline font-black leading-none ${r.rank === 1 ? 'text-lime text-5xl' : 'text-mute text-4xl'}`}>
                {r.rank === 1 ? '🏆' : `#${r.rank}`}
              </span>
              <span class="mt-3 font-headline font-black uppercase text-2xl leading-none tracking-tight text-ink group-hover:text-lime transition-colors">
                {r.entity.shortName}
              </span>
              <span class="mt-1.5 font-sans text-[13px] text-body">{flagEmoji(r.entity.countryCode)} {r.entity.nationality}</span>
              <span class="mt-3 font-headline font-black text-2xl leading-none" style={`color:${r.entity.accent}`}>{r.votes.toLocaleString()}</span>
              <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-mute mt-1">Votes</span>
              {r.headToHeadVotes > 0 && (
                <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-mute mt-1.5">{compactNumber(r.headToHeadVotes)} 1v1 · {r.winRate}% win</span>
              )}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══ Full leaderboard ══ -->
  <section>
    <div class="page-container py-10">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-0.5 h-5 bg-lime inline-block"></span>
        <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">Full Table</h2>
      </div>

      <!-- Column labels (desktop) -->
      <div class={`hidden md:grid ${cols} gap-4 px-4 pb-3 font-mono text-[10px] uppercase tracking-[0.14em] text-mute`}>
        <span>Rank</span>
        <span>Player</span>
        <span class="text-right">Votes</span>
        <span class="text-right">1v1</span>
        <span class="text-right">1v1 Win</span>
      </div>

      <div class="flex flex-col gap-2">
        {rankings.map((r) => (
          <div
            class={`group relative grid ${cols} items-center gap-3 md:gap-4 rounded-md border px-4 py-3.5 transition-colors ${
              r.rank === 1 ? 'border-lime/40' : 'border-hairline hover:border-hairline-strong'
            }`}
            style={r.rank === 1 ? 'background: linear-gradient(90deg, rgba(198,255,0,0.06), var(--color-canvas-soft) 45%)' : 'background: var(--color-canvas-soft)'}>
            <!-- Stretched link — whole row navigates to the profile; the H2H
                 trigger sits above it (z-10) so it opens instead of navigating. -->
            <a href={`/goats/${r.entity.slug}`} class="absolute inset-0 rounded-md" aria-label={`${r.entity.shortName} profile`}></a>

            <!-- Rank -->
            <span class={`font-headline font-black text-2xl leading-none ${r.rank <= 3 ? 'text-lime' : 'text-mute'}`}>
              {r.rank}
            </span>

            <!-- Player -->
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="w-1 h-4 rounded-full shrink-0" style={`background:${r.entity.accent}`}></span>
                <span class="font-headline font-black uppercase text-lg leading-none tracking-tight text-ink group-hover:text-lime transition-colors truncate">
                  {r.entity.shortName}
                </span>
                <span class="text-sm shrink-0">{flagEmoji(r.entity.countryCode)}</span>
              </div>
              <span class="font-sans text-[13px] text-body">{r.entity.nationality} · {r.entity.position}</span>
            </div>

            <!-- Votes (mobile shows here compactly on the right) -->
            <span class="md:text-right font-headline font-black text-xl leading-none text-right" style={`color:${r.entity.accent}`}>
              {r.votes.toLocaleString()}
              <span class="md:hidden font-mono text-[10px] uppercase tracking-[0.14em] text-mute ml-1">Votes</span>
            </span>

            <!-- Head-to-head votes — hover the number for the full 1v1 record -->
            <div class="hidden md:block text-right relative z-10">
              {r.headToHeadVotes > 0 ? (
                <H2HPopover client:visible slug={r.entity.slug} shortName={r.entity.shortName} accent={r.entity.accent} label={compactNumber(r.headToHeadVotes)} />
              ) : (
                <span class="font-mono text-sm text-mute">—</span>
              )}
            </div>

            <!-- 1v1 win rate bar -->
            <div class="hidden md:flex items-center gap-2 justify-end">
              <div class="w-16 h-1.5 rounded-full bg-hairline overflow-hidden">
                <div class="h-full" style={`width:${r.headToHeadVotes > 0 ? r.winRate : 0}%; background:${r.entity.accent}`}></div>
              </div>
              <span class="w-9 text-right font-mono text-sm text-body">{r.headToHeadVotes > 0 ? `${r.winRate}%` : '—'}</span>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-6 font-mono text-[10px] uppercase tracking-[0.14em] text-mute">
        Votes update instantly · +1 from a profile vote, +5 for winning Champion Mode
      </p>
    </div>
  </section>

  <!-- ══ CTA ══ -->
  <section class="border-t border-hairline bg-canvas-soft">
    <div class="page-container py-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <h2 class="font-headline font-black uppercase text-2xl tracking-tight text-ink">Think the order's wrong?</h2>
        <p class="mt-2 font-sans text-body font-medium text-base">Pick your GOAT and move the rankings yourself.</p>
      </div>
      <a href="/play" class="btn btn-primary text-base px-8 py-3.5 whitespace-nowrap">Enter Champion Mode</a>
    </div>
  </section>

</Layout>

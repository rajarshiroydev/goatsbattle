---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getRankings } from '../../lib/queries';
import { getArena, arenas } from '../../data/arenas';
import { flagEmoji, compactNumber } from '../../lib/format';
import H2HPopover from '../../components/H2HPopover.tsx';

// Live leaderboard — recompute ranks on every request.
export const prerender = false;

/** Dark or light text on a solid accent chip. */
function onAccent(hex: string): string {
  const h = hex.replace('#', '');
  return (0.299 * parseInt(h.slice(0, 2), 16) + 0.587 * parseInt(h.slice(2, 4), 16) + 0.114 * parseInt(h.slice(4, 6), 16)) / 255 > 0.6 ? '#0d0d0f' : '#f0f0f2';
}

const { arena } = Astro.params;
const cat = arena ? getArena(arena) : undefined;
if (!arena || !cat) return new Response('Not found', { status: 404 });
const label = cat.label;

const rankings = await getRankings(arena);
const totalVotes = rankings.reduce((s, r) => s + r.votes, 0);

const title = `${label} GOAT Rankings — Live Vote Leaderboard | GOATSBattle`;
const description = `The live ${label.toLowerCase()} GOAT leaderboard, ranked by community votes. See who the world crowns the greatest of all time.`;

const cols = 'grid-cols-[2.5rem_1fr_auto] md:grid-cols-[56px_1fr_130px_110px_120px_90px]';
---

<Layout title={title} description={description}>

  <SectionHeader title="Rankings" live stat={`Updates live · ${totalVotes > 0 ? `${compactNumber(totalVotes)} votes` : 'voting open'}`}>
    <div slot="chips">
      {arenas.map((c) => {
        const on = c.id === arena;
        return (
          <a href={`/rankings/${c.id}`} class={`chip${on ? ' chip-active' : ''}`}
            style={on ? `background:${c.accent}; border-color:${c.accent}; color:${onAccent(c.accent)}` : ''}>
            {c.emoji} {c.label}
          </a>
        );
      })}
    </div>
  </SectionHeader>

  <!-- Leaderboard table -->
  <section class="pt-5 pb-10">
    <div class="page-container">
      <div class="bg-canvas-soft border border-hairline rounded-md overflow-hidden">

        <!-- Column labels -->
        <div class={`grid ${cols} items-center gap-3 md:gap-4 px-[18px] py-3 border-b border-hairline font-mono text-[10px] uppercase tracking-[0.14em] text-mute`}>
          <span>Rank</span>
          <span>Goat</span>
          <span class="text-right">Votes</span>
          <span class="hidden md:block text-right">Win rate</span>
          <span class="hidden md:block text-right">1v1</span>
          <span class="hidden md:block text-right"></span>
        </div>

        {rankings.map((r) => (
          <div class={`group relative grid ${cols} items-center gap-3 md:gap-4 px-[18px] py-3.5 border-b border-hairline last:border-b-0 transition-colors ${r.rank === 1 ? '' : 'hover:bg-canvas-soft-2'}`}
            style={r.rank === 1 ? 'background: linear-gradient(90deg, rgba(198,255,0,0.06), transparent 45%)' : ''}>

            <!-- Stretched link — whole row → profile; H2H trigger sits above (z-10). -->
            <a href={`/goats/${r.entity.slug}`} class="absolute inset-0" aria-label={`${r.entity.shortName} profile`}></a>

            <!-- Rank -->
            <span class={`font-headline font-black text-[22px] leading-none ${r.rank === 1 ? 'text-lime' : r.rank <= 3 ? 'text-body' : 'text-mute'}`}>
              {String(r.rank).padStart(2, '0')}
            </span>

            <!-- Goat -->
            <div class="min-w-0 flex items-center gap-2.5">
              <span class="font-headline font-black uppercase text-[22px] md:text-2xl leading-none tracking-tight text-ink truncate">{r.entity.shortName}</span>
              <span class="text-sm shrink-0 hidden sm:inline">{flagEmoji(r.entity.countryCode)}</span>
              {r.rank === 1 && (
                <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-lime border border-lime/30 rounded-full px-2.5 py-0.5 shrink-0 whitespace-nowrap hidden sm:inline">Reigning goat</span>
              )}
            </div>

            <!-- Votes -->
            <span class="text-right font-mono text-[13px] text-ink whitespace-nowrap">
              {r.votes.toLocaleString()}
              <span class="md:hidden text-mute"> votes</span>
            </span>

            <!-- Win rate -->
            <span class={`hidden md:block text-right font-headline font-black text-xl leading-none ${r.rank === 1 && r.winRate > 0 ? 'text-lime' : 'text-ink'}`}>
              {r.headToHeadVotes > 0 ? `${r.winRate}%` : '—'}
            </span>

            <!-- 1v1 votes (hover for the full record) -->
            <div class="hidden md:block text-right relative z-10">
              {r.headToHeadVotes > 0 ? (
                <H2HPopover client:visible slug={r.entity.slug} shortName={r.entity.shortName} accent={r.entity.accent} label={compactNumber(r.headToHeadVotes)} />
              ) : (
                <span class="font-mono text-sm text-mute">—</span>
              )}
            </div>

            <!-- Profile link -->
            <span class="hidden md:block text-right font-mono text-[11px] text-mute group-hover:text-lime transition-colors whitespace-nowrap">Profile →</span>
          </div>
        ))}
      </div>

      <p class="mt-6 font-mono text-[13px] uppercase tracking-widest text-mute">
        Votes update instantly · +1 from a profile vote, +5 for winning Champion Mode
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-hairline bg-canvas-soft">
    <div class="page-container py-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <h2 class="font-headline font-black uppercase text-2xl tracking-tight text-ink">Think the order's wrong?</h2>
        <p class="mt-2 font-sans text-body font-medium text-base">Pick your GOAT and move the rankings yourself.</p>
      </div>
      <a href="/play" class="btn btn-primary text-base px-8 py-3.5 whitespace-nowrap">Enter Champion Mode</a>
    </div>
  </section>

</Layout>

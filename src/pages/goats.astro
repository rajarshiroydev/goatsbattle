---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import GoatGrid from '../components/GoatGrid.tsx';
import type { GoatCardData, GridArena } from '../components/GoatGrid.tsx';
import { arenas } from '../data/arenas';
import { getStaticRankings } from '../lib/staticCatalog';

const ranked = getStaticRankings();

const goats: GoatCardData[] = ranked.map((r) => {
  const top = r.entity.achievements[0];
  const honour = top ? (top.count > 1 ? `${top.count}× ${top.title}` : top.title) : '';
  return {
    slug: r.entity.slug,
    rank: r.rank,
    arena: r.entity.arena,
    accent: r.entity.accent,
    name: r.entity.name,
    shortName: r.entity.shortName,
    nationality: r.entity.nationality,
    honour,
    votes: r.votes,
    winRate: r.winRate,
  };
});

const gridArenas: GridArena[] = arenas.map((c) => ({ id: c.id, label: c.label, emoji: c.emoji, accent: c.accent }));

const title = 'The Goats — Every Legend on GOATSBattle';
const description = 'Meet the greatest of all time across football, cricket, tennis and Formula 1. Explore profiles, career stats, and head-to-head battles.';
---

<Layout title={title} description={description}>

  <PageHero
    title="The"
    highlight="Goats"
    description="The greatest of all time, across every arena. Explore their careers, dive into the stats, and pit them against each other head-to-head." />

  <section class="pt-8 pb-12">
    <div class="page-container">
      <GoatGrid client:load goats={goats} arenas={gridArenas} />
    </div>
  </section>

</Layout>

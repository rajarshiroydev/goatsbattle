---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Log in — GOATSBattle" description="Log in to vote, comment, and defend your GOAT on GOATSBattle.">
  <section class="max-w-7xl mx-auto px-5 py-24 text-center">
    <h1 class="font-headline font-black uppercase tracking-tight text-4xl md:text-5xl text-ink">
      Log in to <span class="text-lime">GOATSBattle</span>
    </h1>
    <p class="font-sans text-body text-lg mt-3">Cast votes, join the debate, and back your GOAT.</p>
    <button
      id="open-login"
      class="mt-8 font-headline font-black uppercase tracking-wider text-lg bg-lime text-canvas px-8 h-12 rounded-sm hover:bg-lime-dark transition-colors"
    >
      Continue
    </button>
  </section>
</Layout>

<script>
  import { openAuthModal } from '../lib/authModal';
  const go = () => openAuthModal({ mode: 'signin' });
  // Auto-open on load, and on button click as a fallback.
  go();
  document.getElementById('open-login')?.addEventListener('click', go);
</script>

---
import Layout from '../layouts/Layout.astro';
import MarqueeCarousel from '../components/MarqueeCarousel.tsx';
import type { MarqueeBattle } from '../components/MarqueeCarousel.tsx';
import EventRow from '../components/EventRow.astro';
import { getHomeBattleData, getFloorEvents } from '../lib/queries';
import { FLOOR_FILTERS } from '../lib/floor';
import { arenaLabel, arenaEmoji, getArena } from '../data/arenas';
import { compactNumber } from '../lib/format';

// Live scoreboard — read the latest tallies + top match debates on every request.
export const prerender = false;

const [{ mostVoted, totalVotes }, events] = await Promise.all([
  getHomeBattleData(6),
  getFloorEvents({ filter: 'top', userId: Astro.locals.user?.id ?? null, limit: 4 }),
]);
const liveCount = events.filter((e) => e.status === 'live').length;

// Marquee cards for the "Happening Now" carousel (left = lime, right = red).
const marquee: MarqueeBattle[] = mostVoted.slice(0, 5).map((s) => ({
  slug: s.slug,
  arenaLabel: arenaLabel(s.arena),
  arenaEmoji: arenaEmoji(s.arena),
  arenaAccent: getArena(s.arena)?.accent ?? '#c8ff00',
  leftName: s.a.shortName,
  rightName: s.b.shortName,
  leftPct: s.pctA,
  votes: s.total.toLocaleString(),
}));

const floorChips = FLOOR_FILTERS.map((f, i) => ({
  label: f.label,
  href: `/floor?filter=${f.key}`,
  active: i === 0, // "Top" leads the preview
}));

// Scoreboard ticker between the hero and the floor — live scorelines woven
// with a few evergreen call-outs. Duplicated in the track for a seamless loop.
const ticker: string[] = [
  ...marquee.map((b) => `${b.arenaEmoji} ${b.leftName} ${b.leftPct}% ▸ ${b.rightName}`),
  totalVotes > 0 ? `${compactNumber(totalVotes)} votes counted` : 'Voting is live',
  'Settle the debate',
  "Who's your GOAT?",
  'The floor is open',
];
---

<Layout>

  <!-- ══════════════════════════════════════════
       SLIM HERO + "HAPPENING NOW" CAROUSEL (3h)
  ══════════════════════════════════════════ -->
  <section class="border-b border-hairline overflow-x-clip"
    style="background: radial-gradient(ellipse 80% 60% at 20% 120%, rgba(200,255,0,0.08), transparent 60%)">
    <div class="page-container py-11">
      <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-10 items-center">

        <div>
          <h1 class="font-headline font-black uppercase text-ink leading-[0.88] tracking-tight"
            style="font-size: clamp(3.25rem, 8vw, 76px)">
            Who's the <span class="text-lime">Goat?</span>
          </h1>
          <p class="mt-4 font-sans text-body text-base leading-relaxed max-w-md">
            Vote across four arenas, then take it to The Floor — where the world argues it out, one take at a time.
          </p>
          <div class="mt-6 flex flex-wrap gap-2.5">
            <a href="#floor" class="btn btn-primary text-base px-6 py-3">Join the floor ↓</a>
            <a href="/arenas" class="btn btn-secondary text-base px-6 py-3">Browse arenas</a>
          </div>
        </div>

        <div class="w-full max-w-[440px] mx-auto lg:mr-0 lg:ml-auto">
          <MarqueeCarousel client:load battles={marquee} />
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SCOREBOARD TICKER — live scorelines marquee
  ══════════════════════════════════════════ -->
  <section class="marquee border-b border-hairline bg-canvas-soft overflow-hidden">
    <div class="marquee-track flex items-center whitespace-nowrap py-2.5">
      {[0, 1].map((dup) => (
        <div class="marquee-group flex items-center shrink-0" aria-hidden={dup === 1 ? 'true' : undefined}>
          {ticker.map((item) => (
            <span class="flex items-center">
              <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-body px-6">{item}</span>
              <span class="w-1 h-1 rounded-full bg-lime shrink-0"></span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       THE FLOOR — global take stream (preview)
  ══════════════════════════════════════════ -->
  <section id="floor" class="pt-[22px] pb-8 scroll-mt-[60px]">
    <div class="page-container">

      <!-- Header row -->
      <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
        <span class="font-headline font-black uppercase text-3xl leading-none text-ink">The Floor</span>
        <div class="flex flex-wrap items-center gap-1.5 ml-2">
          {floorChips.map((c) => (
            <a href={c.href} class:list={['chip', c.active && 'chip-active']}>{c.label}</a>
          ))}
        </div>
        {liveCount > 0 && (
          <span class="ml-auto flex items-center gap-2">
            <span class="live-dot"></span>
            <span class="font-mono text-[11px] text-mute whitespace-nowrap">{liveCount} live now</span>
          </span>
        )}
      </div>

      <!-- Stream -->
      <div class="mt-4 flex flex-col gap-2.5">
        {events.length > 0 ? (
          <>
            {events.map((event) => <EventRow event={event} />)}
            <a href="/floor"
              class="self-center mt-1.5 chip">Enter the floor ↓</a>
          </>
        ) : (
          <div class="bg-canvas-soft border border-hairline rounded-md px-6 py-10 text-center">
            <p class="font-headline font-black uppercase text-2xl text-ink">The floor is open</p>
            <p class="mt-2 font-sans text-body">Match debates are coming to the floor — check back soon.</p>
            <a href="/goats" class="btn btn-primary text-sm px-6 py-2.5 mt-5">Browse goats</a>
          </div>
        )}
      </div>

    </div>
  </section>

  <style>
    /* Seamless scoreboard scroll — two identical groups slide left by half the
       track width, so the loop point is invisible. */
    .marquee-track {
      width: max-content;
      animation: gb-marquee 45s linear infinite;
    }
    .marquee:hover .marquee-track {
      animation-play-state: paused;
    }
    @keyframes gb-marquee {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .marquee-track { animation: none; }
    }
  </style>

</Layout>

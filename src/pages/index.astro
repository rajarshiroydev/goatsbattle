---
import Layout from '../layouts/Layout.astro';
import BattleCard from '../components/BattleCard.astro';
import { getHomeBattleData } from '../lib/queries';
import { compactNumber } from '../lib/format';
import { categories } from '../data/categories';
import { getEntityBySlug, getEntitiesByCategory, allEntities, allBattlePairs } from '../data';

// Live scoreboard — read the latest tallies on every request.
export const prerender = false;

const { trending, closest, spotlight, totalVotes } = await getHomeBattleData(6);

const sections = [
  {
    id: 'trending',
    label: 'Trending Now',
    href: '/categories',
    badge: (i: number) => (i === 0 ? '🔥 Hot' : undefined),
    battles: trending,
  },
  {
    id: 'closest',
    label: 'Closest Battles',
    href: '/categories',
    badge: (_: number, total: number, margin?: number) =>
      total > 0 ? `${margin}% gap` : undefined,
    battles: closest,
  },
];

// A cross-arena selection of legends for the profiles strip.
const featuredGoatSlugs = ['messi', 'ronaldo', 'bradman', 'tendulkar', 'federer', 'djokovic', 'hamilton', 'senna'];
const featuredGoats = featuredGoatSlugs
  .map((s) => getEntityBySlug(s))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));

const arenaCards = categories.map((c) => ({
  ...c,
  legends: getEntitiesByCategory(c.id).length,
}));
const totalBattles = allBattlePairs.length;
---

<Layout>

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section class="relative min-h-[88vh] flex flex-col items-center justify-center text-center px-5 overflow-hidden">

    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background:
        radial-gradient(ellipse 90% 55% at 50% 110%, rgba(200,255,0,0.09) 0%, transparent 60%),
        radial-gradient(ellipse 55% 40% at 2% 40%, rgba(255,45,85,0.07) 0%, transparent 55%),
        radial-gradient(ellipse 55% 40% at 98% 60%, rgba(59,130,246,0.06) 0%, transparent 55%)">
    </div>

    <div class="relative z-10 max-w-5xl w-full mx-auto">

      <!-- Live pill -->
      <div class="inline-flex items-center gap-2 mb-8">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-lime opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-lime"></span>
        </span>
        <span class="font-mono text-[11px] uppercase tracking-widest text-body">{categories.length} Arenas · Live Now</span>
      </div>

      <h1
        class="font-headline font-black uppercase leading-[0.9] tracking-tight text-ink"
        style="font-size: clamp(5rem, 15vw, 11rem)"
      >
        WHO'S<br>THE <span class="text-lime">GOAT?</span>
      </h1>

      <p class="mt-6 font-sans text-body text-lg leading-relaxed max-w-md mx-auto">
        Football, cricket, tennis, F1. Vote, compare the stats, and see who the world crowns the greatest.
      </p>

      <div class="mt-10 flex flex-wrap gap-3 justify-center">
        <a href="/play"
          class="font-headline font-black uppercase tracking-wider text-base bg-lime text-canvas px-8 h-12 flex items-center rounded-sm hover:bg-lime-dark transition-colors">
          Champion Mode
        </a>
        <a href="/categories"
          class="font-sans font-medium text-sm text-ink border border-hairline-strong px-8 h-12 flex items-center rounded-sm hover:border-lime hover:text-lime transition-colors">
          Browse Arenas →
        </a>
      </div>

      <!-- Arena quick-jump -->
      <div class="mt-8 flex flex-wrap gap-2 justify-center">
        {categories.map((c) => (
          <a href={`/category/${c.id}`}
            class="group inline-flex items-center gap-2 rounded-full border border-hairline px-4 py-1.5 transition-colors"
            onmouseover={`this.style.borderColor='${c.accent}'`}
            onmouseout={`this.style.borderColor=''`}>
            <span class="text-base leading-none">{c.emoji}</span>
            <span class="font-mono text-[11px] uppercase tracking-wider text-body group-hover:text-ink transition-colors">{c.label}</span>
          </a>
        ))}
      </div>

    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 opacity-40">
      <span class="font-mono text-[11px] uppercase tracking-widest text-mute">Scroll</span>
      <div class="w-px h-8 bg-gradient-to-b from-mute to-transparent"></div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       FEATURED RIVALRIES — one marquee battle per arena
  ══════════════════════════════════════════ -->
  {spotlight.length > 0 && (
    <section class="border-t border-hairline bg-canvas-soft" id="featured">
      <div class="max-w-7xl mx-auto px-5 py-14 md:py-16">
        <div class="flex items-center justify-between mb-8">
          <div class="flex items-center gap-3">
            <span class="w-0.5 h-6 bg-lime inline-block"></span>
            <span class="font-headline font-black uppercase text-2xl tracking-tight text-ink">Featured Rivalries</span>
          </div>
          <span class="font-mono text-[11px] uppercase tracking-widest text-mute hidden sm:inline">One per arena</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {spotlight.map((battle) => (
            <BattleCard battle={battle} badge="Marquee" />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════════════
       LIVE BATTLE SECTIONS — trending / closest
  ══════════════════════════════════════════ -->
  {sections.map((section) => (
    <section class="border-t border-hairline" id={section.id}>
      <div class="max-w-7xl mx-auto px-5 py-14 md:py-16">

        <div class="flex items-center justify-between mb-8">
          <div class="flex items-center gap-3">
            <span class="w-0.5 h-6 bg-lime inline-block"></span>
            <span class="font-headline font-black uppercase text-2xl tracking-tight text-ink">{section.label}</span>
          </div>
          <a href={section.href}
            class="font-sans text-sm text-body hover:text-lime transition-colors">
            See all →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {section.battles.map((battle, i) => (
            <BattleCard battle={battle} badge={section.badge(i, battle.total, battle.margin)} />
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- ══════════════════════════════════════════
       MEET THE GOATS — cross-arena profile strip
  ══════════════════════════════════════════ -->
  <section class="border-t border-hairline bg-canvas-soft">
    <div class="max-w-7xl mx-auto px-5 py-14 md:py-16">
      <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-3">
          <span class="w-0.5 h-6 bg-lime inline-block"></span>
          <span class="font-headline font-black uppercase text-2xl tracking-tight text-ink">Meet the Goats</span>
        </div>
        <a href="/goats" class="font-sans text-sm text-body hover:text-lime transition-colors">All goats →</a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
        {featuredGoats.map((e) => (
          <a href={`/player/${e.slug}`}
            class="group relative flex flex-col justify-between overflow-hidden rounded-md border bg-canvas p-4 min-h-[140px] transition-all duration-200 hover:-translate-y-1"
            style={`border-color:${e.accent}33`}
            onmouseover={`this.style.borderColor='${e.accent}'`}
            onmouseout={`this.style.borderColor='${e.accent}33'`}>
            <div class="absolute inset-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity"
              aria-hidden="true"
              style={`background: radial-gradient(ellipse 90% 70% at 50% 120%, ${e.accent}22 0%, transparent 65%)`}></div>
            <span class="relative font-headline font-black text-4xl leading-none select-none" style={`color:${e.accent}`}>
              {e.shortName.charAt(0)}
            </span>
            <div class="relative mt-3">
              <span class="block font-headline font-black uppercase text-lg leading-none tracking-tight text-ink truncate">{e.shortName}</span>
              <span class="block font-mono text-[11px] uppercase tracking-wider text-mute mt-1 truncate">{e.category}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       ARENAS (CATEGORY GRID) — all live
  ══════════════════════════════════════════ -->
  <section class="border-t border-hairline">
    <div class="max-w-7xl mx-auto px-5 py-16 md:py-20">

      <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-3">
          <span class="w-0.5 h-6 bg-lime inline-block"></span>
          <span class="font-headline font-black uppercase text-2xl tracking-tight text-ink">Arenas</span>
        </div>
        <a href="/categories" class="font-sans text-sm text-body hover:text-lime transition-colors">All arenas →</a>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        {arenaCards.map((c) => (
          <a href={`/category/${c.id}`}
            class="group relative flex flex-col justify-between bg-canvas-soft border border-hairline rounded-md p-5 h-40 overflow-hidden transition-all duration-200"
            style="box-shadow: var(--shadow-card)"
            onmouseover={`this.style.borderColor='${c.accent}'`}
            onmouseout={`this.style.borderColor=''`}>
            <div class="absolute inset-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300"
              aria-hidden="true"
              style={`background: radial-gradient(ellipse 80% 90% at 100% 0%, ${c.accent}1f 0%, transparent 60%)`}></div>
            <div class="relative flex items-start justify-between">
              <span class="font-headline font-black uppercase text-3xl leading-none tracking-tight text-ink">{c.label}</span>
              <span class="text-3xl leading-none shrink-0">{c.emoji}</span>
            </div>
            <div class="relative flex items-end justify-between">
              <span class="font-mono text-[11px] uppercase tracking-wider flex items-center gap-1.5" style={`color:${c.accent}`}>
                <span class="w-1.5 h-1.5 rounded-full inline-block" style={`background:${c.accent}`}></span>{c.legends} Goats
              </span>
              <span class="font-mono text-[11px] uppercase tracking-wider text-mute group-hover:text-body transition-colors">Enter →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CHAMPION MODE PROMO BAND
  ══════════════════════════════════════════ -->
  <section class="border-t border-hairline bg-canvas-soft">
    <div class="max-w-7xl mx-auto px-5 py-16 md:py-20">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">

        <div class="max-w-xl">
          <p class="font-mono text-[11px] uppercase tracking-widest text-lime mb-3">Champion Mode</p>
          <h2
            class="font-headline font-black uppercase leading-none tracking-tight text-ink"
            style="font-size: clamp(2.5rem, 6vw, 4.5rem)"
          >
            CROWN YOUR GOAT,<br>ONE VOTE AT A TIME.
          </h2>
          <p class="mt-4 font-sans text-body text-base leading-relaxed max-w-sm">
            A blind gauntlet. The reigning winner stays on the throne and faces the next challenger —
            you decide who survives. The last one standing is your GOAT.
          </p>
        </div>

        <div class="shrink-0 w-full md:w-auto">
          <div class="space-y-2 w-full md:w-72">
            {[
              { a: 'MESSI', b: 'ZIDANE', state: 'done' },
              { a: 'MESSI', b: 'CRUYFF', state: 'active' },
              { a: '?', b: '?', state: 'next' },
            ].map(({ a, b, state }) => (
              <div class={[
                'flex items-center gap-3 px-4 py-3 rounded-sm border transition-all',
                state === 'done'   ? 'bg-canvas border-hairline opacity-40' : '',
                state === 'active' ? 'bg-canvas border-lime' : '',
                state === 'next'   ? 'bg-canvas border-hairline opacity-25' : '',
              ].join(' ')}>
                <span class={['font-headline font-black uppercase text-base leading-none', state === 'done' ? 'text-mute' : 'text-ink'].join(' ')}>{a}</span>
                <span class={['font-headline font-black text-lg leading-none', state === 'active' ? 'text-lime' : 'text-mute'].join(' ')}>/</span>
                <span class={['font-headline font-black uppercase text-base leading-none', state === 'done' ? 'text-mute' : 'text-ink'].join(' ')}>{b}</span>
                {state === 'done'   && <span class="ml-auto font-mono text-[11px] uppercase text-mute">Winner stays</span>}
                {state === 'active' && <span class="ml-auto font-mono text-[11px] uppercase text-lime animate-pulse">Now</span>}
                {state === 'next'   && <span class="ml-auto font-mono text-[11px] uppercase text-mute">Next up</span>}
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-10">
        <a href="/play"
          class="inline-flex items-center font-headline font-black uppercase tracking-wider text-base bg-lime text-canvas px-8 h-12 rounded-sm hover:bg-lime-dark transition-colors">
          Start Champion Mode
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       STATS PROOF BAND
  ══════════════════════════════════════════ -->
  <section class="border-t border-hairline">
    <div class="max-w-7xl mx-auto px-5 py-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[
          { stat: String(totalBattles), label: 'Active Battles' },
          { stat: String(allEntities.length), label: 'Legendary Goats' },
          { stat: totalVotes > 0 ? compactNumber(totalVotes) : '∞', label: 'Votes Cast' },
          { stat: String(categories.length), label: 'Arenas' },
        ].map(({ stat, label }) => (
          <div>
            <p class="font-headline font-black text-5xl leading-none tracking-tight text-lime">{stat}</p>
            <p class="font-sans text-sm text-body mt-2 uppercase tracking-wider">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

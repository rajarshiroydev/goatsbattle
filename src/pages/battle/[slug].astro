---
import Layout from '../../layouts/Layout.astro';
import { getEntityBySlug, getBattlesForEntity, footballBattlePairs } from '../../data/football';
import { getBattleId, parseBattleSlug, getCanonicalBattleSlug } from '../../lib/battle';
import { compareEntities } from '../../lib/stats';
import RadarChart from '../../components/RadarChart.astro';
import TrophyTimeline from '../../components/TrophyTimeline.astro';
import VoteWidget from '../../components/VoteWidget.tsx';

export function getStaticPaths() {
  return footballBattlePairs.map(([a, b]) => ({
    params: { slug: getBattleId(a, b) },
  }));
}

const { slug } = Astro.params;
const parsed = parseBattleSlug(slug);
if (!parsed) return Astro.redirect('/');

const [slugA, slugB] = parsed;

// Redirect non-canonical slugs
const canonical = getCanonicalBattleSlug(slugA, slugB);
if (slug !== canonical) return Astro.redirect(`/battle/${canonical}`, 301);

const entityA = getEntityBySlug(slugA);
const entityB = getEntityBySlug(slugB);
if (!entityA || !entityB) return Astro.redirect('/');

const title = `${entityA.name} vs ${entityB.name} — Who's the Greater GOAT? | GOATSBattle`;
const description = `${entityA.name} vs ${entityB.name}: side-by-side career stats, achievements, and head-to-head comparison. Cast your vote and see what the world thinks.`;

// Stat comparison: shared sections with per-stat leader + proportional split,
// plus the category-win tally. See src/lib/stats.ts.
const { sections: sharedSections, winsA, winsB, leader: statLeader } = compareEntities(entityA, entityB);

const relatedA = getBattlesForEntity(slugA, { exclude: slugB, limit: 4 });
const relatedB = getBattlesForEntity(slugB, { exclude: slugA, limit: 4 });

const ogImage = `/og/battle/${canonical}.png`;
---

<Layout title={title} description={description} image={ogImage}>

  <!-- Battle Hero — the main slash split -->
  <section class="border-b border-hairline relative overflow-hidden">

    <!-- Atmospheric glows -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(ellipse 40% 60% at 20% 50%, rgba(255,45,85,0.08) 0%, transparent 70%), radial-gradient(ellipse 40% 60% at 80% 50%, rgba(59,130,246,0.08) 0%, transparent 70%)">
    </div>

    <div class="relative max-w-7xl mx-auto px-5 py-8">

      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-mute mb-6">
        <a href="/" class="hover:text-body transition-colors">GOATSBattle</a>
        <span>/</span>
        <a href="/category/football" class="hover:text-body transition-colors">Football</a>
        <span>/</span>
        <span class="text-ink">{entityA.shortName} vs {entityB.shortName}</span>
      </div>

      <!-- Title -->
      <h1 class="font-headline font-black uppercase leading-none tracking-tight text-ink text-center mb-8"
        style="font-size: clamp(2rem, 5vw, 4rem)">
        {entityA.name}
        <span class="text-lime"> / </span>
        {entityB.name}
      </h1>

      <!-- Split card -->
      <div class="relative flex items-stretch min-h-[220px] md:min-h-[280px] bg-canvas-soft border border-hairline rounded-md overflow-hidden">

        <!-- Player A -->
        <div class="flex-1 flex flex-col justify-between px-6 py-8 md:px-10 md:py-10">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-body mb-2">{entityA.nationality}</p>
            <h2 class="font-headline font-black uppercase leading-none tracking-tight text-ink"
              style="font-size: clamp(2.5rem, 6vw, 5rem)">
              {entityA.shortName}
            </h2>
          </div>
          <div class="mt-4">
            <span class="font-sans text-sm text-body">{entityA.position}</span>
          </div>
        </div>

        <!-- The "/" slash — battle divider -->
        <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 flex items-center justify-center pointer-events-none z-10">
          <span class="font-headline font-black text-[8rem] md:text-[12rem] leading-none text-lime select-none"
            style="text-shadow: 0 0 60px rgba(200,255,0,0.3)">/</span>
        </div>

        <!-- Player B -->
        <div class="flex-1 flex flex-col justify-between px-6 py-8 md:px-10 md:py-10 items-end text-right">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-body mb-2">{entityB.nationality}</p>
            <h2 class="font-headline font-black uppercase leading-none tracking-tight text-ink"
              style="font-size: clamp(2.5rem, 6vw, 5rem)">
              {entityB.shortName}
            </h2>
          </div>
          <div class="mt-4">
            <span class="font-sans text-sm text-body">{entityB.position}</span>
          </div>
        </div>
      </div>

      <!-- Vote widget — Preact island, fetches live results & casts votes -->
      <VoteWidget
        client:load
        battleId={canonical}
        entityAId={entityA.id}
        entityBId={entityB.id}
        shortA={entityA.shortName}
        shortB={entityB.shortName}
      />
    </div>
  </section>

  <!-- Stat Scoreline — who leads on the raw numbers -->
  <section class="border-b border-hairline bg-canvas-soft">
    <div class="max-w-7xl mx-auto px-5 py-8">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-0.5 h-5 bg-lime inline-block"></span>
        <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">Stat Scoreline</h2>
        <span class="font-mono text-[10px] uppercase tracking-widest text-mute hidden sm:inline">Categories led</span>
      </div>

      <div class="flex items-stretch gap-3">
        <!-- A tally -->
        <div class={`flex-1 rounded-md border px-5 py-5 ${statLeader === 'a' ? 'border-lime bg-lime/5' : 'border-hairline bg-canvas'}`}>
          <p class="font-mono text-[10px] uppercase tracking-widest text-mute mb-1">{entityA.shortName}</p>
          <div class="flex items-baseline gap-2">
            <span class={`font-headline font-black leading-none ${statLeader === 'a' ? 'text-lime' : 'text-ink'}`} style="font-size: clamp(2.5rem, 7vw, 4rem)">{winsA}</span>
            {statLeader === 'a' && <span class="font-mono text-[10px] uppercase tracking-widest text-lime">Leads</span>}
          </div>
        </div>

        <div class="flex items-center justify-center px-1">
          <span class="font-mono text-[10px] uppercase tracking-widest text-mute">vs</span>
        </div>

        <!-- B tally -->
        <div class={`flex-1 rounded-md border px-5 py-5 text-right ${statLeader === 'b' ? 'border-lime bg-lime/5' : 'border-hairline bg-canvas'}`}>
          <p class="font-mono text-[10px] uppercase tracking-widest text-mute mb-1">{entityB.shortName}</p>
          <div class="flex items-baseline gap-2 justify-end">
            {statLeader === 'b' && <span class="font-mono text-[10px] uppercase tracking-widest text-lime">Leads</span>}
            <span class={`font-headline font-black leading-none ${statLeader === 'b' ? 'text-lime' : 'text-ink'}`} style="font-size: clamp(2.5rem, 7vw, 4rem)">{winsB}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stat Comparison Sections — mixed-data cards -->
  {sharedSections.map(section => (
    <section class="border-b border-hairline">
      <div class="max-w-7xl mx-auto px-5 py-10">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-3">
            <span class="w-0.5 h-5 bg-lime inline-block"></span>
            <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">{section.heading}</h2>
          </div>
          <!-- Legend -->
          <div class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-wider text-mute">
            <span class="text-ink">{entityA.shortName}</span>
            <span>/</span>
            <span class="text-ink">{entityB.shortName}</span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {section.rows.map(row => (
            <div class="bg-canvas-soft border border-hairline rounded-md px-5 py-4">
              <!-- Label -->
              <p class="font-mono text-[10px] uppercase tracking-wider text-mute text-center mb-3">{row.label}</p>

              <!-- Values -->
              <div class="flex items-end justify-between gap-3 mb-3">
                <div class="flex items-center gap-1.5">
                  {row.winner === 'a' && <span class="w-1.5 h-1.5 rounded-full bg-lime inline-block mb-1.5"></span>}
                  <span class={`font-headline font-black text-3xl leading-none ${row.winner === 'a' ? 'text-lime' : 'text-ink'}`}>{row.valueA}</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class={`font-headline font-black text-3xl leading-none text-right ${row.winner === 'b' ? 'text-lime' : 'text-ink'}`}>{row.valueB}</span>
                  {row.winner === 'b' && <span class="w-1.5 h-1.5 rounded-full bg-lime inline-block mb-1.5"></span>}
                </div>
              </div>

              <!-- Versus bar -->
              <div class="flex h-1.5 gap-0.5 rounded-full overflow-hidden">
                <div style={`width:${row.pctA}%`} class={row.winner === 'a' ? 'bg-lime' : 'bg-hairline-strong'}></div>
                <div style={`width:${row.pctB}%`} class={row.winner === 'b' ? 'bg-lime' : 'bg-hairline-strong'}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Radar — normalised shape of greatness -->
  <RadarChart entityA={entityA} entityB={entityB} />

  <!-- Trophy timeline — honours across the years -->
  <TrophyTimeline entityA={entityA} entityB={entityB} />

  <!-- Achievements Comparison -->
  <section class="border-b border-hairline bg-canvas-soft">
    <div class="max-w-7xl mx-auto px-5 py-10">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-0.5 h-5 bg-lime inline-block"></span>
        <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">Honours</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
        {[entityA, entityB].map(entity => (
          <div>
            <div class="flex items-center gap-2 mb-4">
              <h3 class="font-headline font-black uppercase text-base text-ink">{entity.shortName}</h3>
              <span class="font-mono text-[10px] uppercase tracking-widest text-mute">{entity.achievements.reduce((s, a) => s + a.count, 0)} titles</span>
            </div>
            <div class="flex flex-wrap gap-2">
              {entity.achievements.map(a => (
                <div class="flex items-center gap-2 bg-canvas border border-hairline rounded-sm px-3 py-2">
                  {a.count > 1 && <span class="font-headline font-black text-base leading-none text-lime">{a.count}×</span>}
                  <span class="font-sans text-sm text-ink">{a.title}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- More Battles -->
  <section class="border-b border-hairline">
    <div class="max-w-7xl mx-auto px-5 py-10">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-0.5 h-5 bg-lime inline-block"></span>
        <h2 class="font-headline font-black uppercase text-xl tracking-tight text-ink">More Battles</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {[{ entity: entityA, related: relatedA }, { entity: entityB, related: relatedB }].map(({ entity, related }) => (
          <div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-mute mb-3">{entity.shortName} vs...</p>
            <div class="space-y-2">
              {related.map(({ battleSlug, opponent }) => (
                <a href={`/battle/${battleSlug}`}
                  class="flex items-center justify-between bg-canvas-soft border border-hairline hover:border-lime rounded-sm px-4 py-3 transition-colors group">
                  <span class="font-headline font-black uppercase text-base text-ink group-hover:text-lime transition-colors">
                    {entity.shortName} / {opponent.shortName}
                  </span>
                  <span class="font-mono text-[10px] text-mute group-hover:text-lime transition-colors">→</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Player profile links -->
  <section class="border-b border-hairline">
    <div class="max-w-7xl mx-auto px-5 py-8">
      <div class="flex flex-wrap gap-4">
        {[entityA, entityB].map(entity => (
          <a href={`/player/${entity.slug}`}
            class="font-sans text-sm text-body border border-hairline rounded-sm px-5 h-10 flex items-center hover:text-ink hover:border-hairline-strong transition-colors whitespace-nowrap">
            {entity.name} Profile →
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

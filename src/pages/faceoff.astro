---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import BattlePicker from '../components/BattlePicker.tsx';
import type { PickerEntity, PickerCategory } from '../components/BattlePicker.tsx';
import { allEntities } from '../data';
import { categories } from '../data/categories';

// Everything the picker needs travels in the initial payload — no per-arena
// fetch. Static shell; the island reads ?goat=<slug> for any pre-selection.
const roster: PickerEntity[] = allEntities.map((e) => ({
  slug: e.slug,
  name: e.name,
  shortName: e.shortName,
  nationality: e.nationality,
  accent: e.accent,
  category: e.category,
}));

const pickerCategories: PickerCategory[] = categories
  .filter((c) => c.active)
  .map((c) => ({ id: c.id, label: c.label, emoji: c.emoji, accent: c.accent }));

const title = 'Face Off — Pick Two GOATs | GOATSBattle';
const description =
  'Pick any two legends from the same arena and settle it with a vote. Choose your fighters and see who the world backs.';
---

<Layout title={title} description={description}>
  <PageHeader
    title="Face"
    highlight="Off"
    subtitle="Pick an arena, choose two legends, and settle the debate with a vote. Only same-arena GOATs can face off." />

  <section>
    <div class="max-w-7xl mx-auto px-5 py-10 md:py-12">
      <BattlePicker client:load roster={roster} categories={pickerCategories} />
    </div>
  </section>
</Layout>

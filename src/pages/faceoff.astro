---
import Layout from '../layouts/Layout.astro';
import BattlePicker from '../components/BattlePicker.tsx';
import type { PickerEntity, PickerArena } from '../components/BattlePicker.tsx';
import { allEntities } from '../data';
import { arenas } from '../data/arenas';

// Everything the picker needs travels in the initial payload — no per-arena
// fetch. Static shell; the island reads ?goat=<slug> for any pre-selection.
const roster: PickerEntity[] = allEntities.map((e) => ({
  slug: e.slug,
  name: e.name,
  shortName: e.shortName,
  nationality: e.nationality,
  accent: e.accent,
  arena: e.arena,
}));

const pickerArenas: PickerArena[] = arenas
  .filter((c) => c.active)
  .map((c) => ({ id: c.id, label: c.label, emoji: c.emoji, accent: c.accent }));

const title = 'Face Off — Pick Two GOATs | GOATSBattle';
const description =
  'Pick any two legends from the same arena and settle it with a vote. Choose your fighters and see who the world backs.';
---

<Layout title={title} description={description}>
  <section class="pt-9 pb-2 text-center">
    <div class="page-container">
      <h1 class="font-headline font-black uppercase leading-[0.95] tracking-tight text-ink text-5xl md:text-[52px]">
        Face <span class="text-lime">Off</span>
      </h1>
      <p class="mt-2 font-sans text-body">Pick any two from an arena. Settle it in the arena.</p>
    </div>
  </section>

  <section class="pt-5 pb-12">
    <div class="page-container">
      <BattlePicker client:load roster={roster} arenas={pickerArenas} />
    </div>
  </section>
</Layout>
